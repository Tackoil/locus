{
  "name": "locus-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:wasm && node build.mjs",
    "build:wasm": "wasm-pack build ../crates/locus-wasm --target web --release --no-opt --out-dir ../../target/wasm/pkg --out-name locus --locked",
    "test": "node --test tests/*.test.mjs",
    "preview": "python3 -m http.server 4173 --bind 127.0.0.1 --directory dist"
  },
  "devDependencies": {
    "marked": "^16.4.1"
  }
}
