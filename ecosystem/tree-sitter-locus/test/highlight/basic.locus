locus 0 beta 4
// <- keyword
//    ^ number
point A' = point()
// <- type
//    ^ variable
//         ^ function
num angle = 90deg
//          ^ number
class faint { accent: #Ab12EF }
// <- keyword
//    ^ type
//            ^ property
//                    ^ string.special
circle c = circle(2) [faint]
//                    ^ attribute
point B = c.center
//          ^ property
label caption = label(B, "hello $\alpha$ \n")
//                       ^ string
//                               ^ string.escape
//                                       ^ string.escape
label math = label(A', $\frac{1}{2}$)
//                      ^ string.escape
//                           ^ string.special
// A comment containing point, 12, and "text".
// <- comment
assert true and not false
//     ^ boolean
//          ^ operator
//              ^ operator
//                  ^ boolean
