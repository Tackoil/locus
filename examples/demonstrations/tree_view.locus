locus 0 beta 6

meta title = "Tree view: package hierarchy"
meta note = "The documented packages/mermaid/parser hierarchy and source files, with a project root added to anchor the single figure."

style textbook

// Mermaid reference: https://mermaid.js.org/syntax/treeView.html
// Reference example: Nested packages/mermaid/parser example

class hidden { opacity: 0 }
class boundary { accent: gray, fill: none }

fn node(text) {
    rounded_rect shape()
    label caption(text)
    rel center(caption, shape)
    rel contain(shape, caption)
}

node entry0("project/")
node entry1("packages/")
node entry2("mermaid/")
node entry3("src/")
node entry4("parser.ts")
node entry5("renderer.ts")
node entry6("package.json")
node entry7("parser/")
node entry8("src/")
node entry9("README.md")
rel gap_y(entry0.shape, entry1.shape, entry2.shape, entry3.shape, entry4.shape, entry5.shape, entry6.shape, entry7.shape, entry8.shape, entry9.shape)
group depth0(entry0.shape)
group depth1(entry1.shape, entry9.shape)
rel align_left(entry1.shape, entry9.shape)
group depth2(entry2.shape, entry7.shape)
rel align_left(entry2.shape, entry7.shape)
group depth3(entry3.shape, entry6.shape, entry8.shape)
rel align_left(entry3.shape, entry6.shape, entry8.shape)
group depth4(entry4.shape, entry5.shape)
rel align_left(entry4.shape, entry5.shape)
rel gap_x(depth0, depth1, depth2, depth3, depth4)
point entry1_elbow = intersect(line(entry0.shape.nw, entry0.shape.sw), line(entry1.shape.w, entry1.shape.e)) [hidden] { mark: none }
segment entry1_stem(entry0.shape.sw, entry1_elbow) [boundary]
segment entry1_twig(entry1_elbow, entry1.shape.w) [boundary]
