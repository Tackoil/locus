locus 0 beta 6

meta title = "Agent workflow: never render until check passes"
meta note = "Nodes own their placement; anchor relations define the spine and fix branch"

style textbook

// ---- sizing constants --------------------------------------
num bw    = 3.4        // box width
num bh    = 1.1        // box height

// ---- spine nodes --------------------------------------------
rect n1(bw, bh)
label t1(n1.center, "locus init")  { dir: center }

rect n2(bw, bh)
label t2(n2.center, "locus add < ops.locus")  { dir: center }

rect n3(bw, bh)
label t3(n3.center, "locus check")  { dir: center }

diamond n4(3.2, 1.5)
label t4(n4.center, "exit 0?")  { dir: center }

rect n5(bw, bh)   [highlight]
label t5(n5.center, "locus render -o fig.svg")  { dir: center }

// ---- side node: fix ------------------------------------------
rect nf(bw, bh)
label tf(nf.center, "fix ops (update / edit)")  { dir: center }

rel column(n1, n2, n3, n4, n5)
rel row(n4, nf)

// ---- edges ----------------------------------------------------
arrow a1(n1.s, n2.n)  { head: -> }
arrow a2(n2.s, n3.n)  { head: -> }
arrow a3(n3.s, n4.n)  { head: -> }
arrow a4(n4.s, n5.n)  { head: -> }
label ly(n4.s, "yes")  { dir: SW, gap: 0.15 }
arrow a5(n4.e, nf.w)  { head: -> }
label ln(n4.e, "no")   { dir: NE, gap: 0.15 }
arrow a6(nf.n, n2.e)  { head: ->, bend: 40deg }

// ---- layout invariants — the Locus payoff ---------------------
assert collinear(n1.center, n2.center, n3.center, n4.center, n5.center) // spine
assert vdist(n2.center, n1.center) == vdist(n3.center, n2.center)       // equal pitch
assert n1.width == n3.width                        // equal widths
assert align_center_y(n4.center, nf.center)            // fix branch on the decision row

// ---- beta 6 specification acceptance: composition and measured layout ----
// Explicit geometry above is retained; this panel exercises engine-owned sizes.
fn beta6_step(text, appearance) {
    rounded_rect shape() [appearance]
    label caption(text) [main]
    rel center(caption, shape)
    rel contain(shape, caption)
}

fn beta6_pair(first_text, second_text) {
    beta6_step first(first_text, main)
    beta6_step second(second_text, highlight)
    group stages(first, second)
    group repeated(stages, first, second)
    rel column(stages)
    rel second.shape.width == first.shape.width
    rel second.shape.height == first.shape.height

    // Clip center-to-center paths without changing their logical measurements.
    arrow forward(first.shape.center, second.shape.center)
    label next(forward, "advance") { near: middle, side: left }
    rel trim_endpoints(forward, first.shape)
    rel trim_endpoints(forward, second.shape)
    arrow back(second.shape.e, first.shape.e) { route: orthogonal, side: right }
    label retry(back, "retry") { near: middle, side: right }
    rel avoid(back, first.shape, second.shape, forward)

    assert center(repeated, stages)
    assert contain(first.shape, first.caption) and contain(second.shape, second.caption)
    assert align_center_x(first, second)
    assert first.shape.width == second.shape.width and first.shape.height == second.shape.height
    assert forward.length == dist(first.shape.center, second.shape.center)
    assert on(first.shape.e, first.shape) and on(second.shape.e, second.shape)
}

beta6_pair measured_panel("Automatic box sizing", "A longer measured caption stays inside its box") [construction]
rel gap_x(nf, measured_panel)
rel align_top(nf, measured_panel)
rect measured_banner()
label measured_heading("Measured layout and routed feedback") { role: title }
rel center(measured_heading, measured_banner)
rel contain(measured_banner, measured_heading)
rel cover_x(measured_banner, measured_panel)
rel gap_y(measured_banner, measured_panel)
assert contain(measured_banner, measured_heading)
