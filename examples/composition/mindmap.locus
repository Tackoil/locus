segment edge_n4(n3.shape.e, n4.shape.w)
group n3_tree(n3, n4_tree)
rel gap_y(n2_tree, n3_tree)
rel align_left(n2_tree, n3_tree)
group n1_children(n2_tree, n3_tree)
