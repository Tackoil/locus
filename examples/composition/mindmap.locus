locus 0 beta 6

meta title = "Mindmap: origins, research, and tools"
meta note = "The documented Origins/Research/Tools hierarchy, including automatic creation and three uses. The decorative book icon is omitted."

style textbook

// Mermaid reference: https://mermaid.js.org/syntax/mindmap.html
// Reference example: Mindmap introduction


fn node(text) {
    rounded_rect shape()
    label caption(text)
    rel center(caption, shape)
    rel contain(shape, caption)
}

node n0("mindmap")
node n1("Origins")
