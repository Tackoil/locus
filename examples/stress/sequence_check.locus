locus 0 beta 6

meta title = "Sequence: agent runs locus check"
meta note = "Ordered message rows lie on vertical guides; projected endpoints share a horizontal line"

style textbook

class lifeline { stroke: dash(5, 3), weight: 0.75, accent: #64748B, cap: round }
class ret      { stroke: dash(6, 3), weight: 1.25, accent: #475569, cap: round }

// ---- sizing constants ---------------------------------------
num bw = 2.6         // participant box width
num bh = 0.9         // participant box height

// ---- participant heads ---------------------------------------
rect boxA(bw, bh)
point Ac = boxA.center { mark: none }
label hA(boxA.center, "Agent")  { dir: center }

rect boxB(bw, bh)
point Bc = boxB.center { mark: none }
label hB(boxB.center, "locus CLI")  { dir: center }

rect boxC(bw, bh)
point Cc = boxC.center { mark: none }
label hC(boxC.center, "Kernel")  { dir: center }

// ---- lifelines (exact dash, weight, color, and cap via a declared class)
point endA() { mark: none }
rel align_center_x(boxA, endA)
segment lifeA(boxA.s, endA)  [lifeline]
point endB() { mark: none }
rel align_center_x(boxB, endB)
segment lifeB(boxB.s, endB)  [lifeline]
point endC() { mark: none }
rel align_center_x(boxC, endC)
segment lifeC(boxC.s, endC)  [lifeline]

// ---- message rows (layout chooses the first span; later rows reuse that span)
point r1() where { on(r1, lifeA) } { mark: none }
point r2() where { on(r2, lifeA) } { mark: none }
point r3 = translate(r2, r1, r2) { mark: none }
point r4 = translate(r3, r1, r2) { mark: none }
point r5 = translate(r4, r1, r2) { mark: none }
point r6 = translate(r5, r1, r2) { mark: none }

// ---- messages --------------------------------------------------
point p1b = foot(r1, lifeB)  { mark: none }
arrow m1(r1, p1b)  { head: -> }
label l1(m1, "check fig.locus") { near: middle, side: above }

point p2b = foot(r2, lifeB)  { mark: none }
point p2c = foot(r2, lifeC)  { mark: none }
arrow m2(p2b, p2c)  { head: -> }
label l2(m2, "parse + solve + evaluate") { near: middle, side: above }

point p3b = foot(r3, lifeB)  { mark: none }
point p3c = foot(r3, lifeC)  { mark: none }
arrow m3(p3c, p3b)  [ret]  { head: -> }   // return
label l3(m3, "resolved scene + DOF report") { near: middle, side: above }

point p4b = foot(r4, lifeB)  { mark: none }
point p4c = foot(r4, lifeC)  { mark: none }
arrow m4(p4b, p4c)  { head: -> }
label l4(m4, "run asserts") { near: middle, side: above }

point p5b = foot(r5, lifeB)  { mark: none }
point p5c = foot(r5, lifeC)  { mark: none }
arrow m5(p5c, p5b)  [ret]  { head: -> }
label l5(m5, "$a_3$ failed: got 1.618") { near: middle, side: above }

point p6b = foot(r6, lifeB)  { mark: none }
arrow m6(p6b, r6)  [ret]  { head: -> }
label l6(m6, "exit 1 + JSON report") { near: middle, side: above }

// ---- invariants -------------------------------------------------
assert parallel(lifeA, lifeB) and parallel(lifeB, lifeC)
assert align_center_y(r1, p1b)                         // messages horizontal
assert (length(seg(r1, r2)) == length(seg(r2, r3)))         // uniform rhythm
assert on(p2b, lifeB) and on(p2c, lifeC)

// ---- stress construction network ----
rect boxD(bw, bh)
point Dc = boxD.center { mark: none }
label hD(boxD.center, "Audit / storage") { dir: center }
point endD() { mark: none }
rel align_center_x(boxD, endD)
segment lifeD(boxD.s, endD) [lifeline]
point sr7 = translate(r6, r1, r2) { mark: none }
point ss7 = sr7 { mark: none }
point se7 = foot(sr7, lifeB) { mark: none }
arrow sm7(ss7, se7) [main]
label sl7(sm7, "retry with corrected constraints") { near: middle, side: above }
assert align_center_y(ss7, se7)
assert on(ss7, lifeA) and on(se7, lifeB)
point sr8 = translate(sr7, r1, r2) { mark: none }
point ss8 = foot(sr8, lifeB) { mark: none }
point se8 = foot(sr8, lifeC) { mark: none }
arrow sm8(ss8, se8) [main]
label sl8(sm8, "solve shared geometry") { near: middle, side: above }
assert align_center_y(ss8, se8)
assert on(ss8, lifeB) and on(se8, lifeC)
point sr9 = translate(sr8, r1, r2) { mark: none }
point ss9 = foot(sr9, lifeC) { mark: none }
point se9 = foot(sr9, lifeD) { mark: none }
arrow sm9(ss9, se9) [main]
label sl9(sm9, "read cached measurements") { near: middle, side: above }
assert align_center_y(ss9, se9)
assert on(ss9, lifeC) and on(se9, lifeD)
point sr10 = translate(sr9, r1, r2) { mark: none }
point ss10 = foot(sr10, lifeD) { mark: none }
point se10 = foot(sr10, lifeC) { mark: none }
arrow sm10(ss10, se10) [ret]
label sl10(sm10, "cache miss") { near: middle, side: above }
assert align_center_y(ss10, se10)
assert on(ss10, lifeD) and on(se10, lifeC)
point sr11 = translate(sr10, r1, r2) { mark: none }
point ss11 = foot(sr11, lifeC) { mark: none }
point se11 = foot(sr11, lifeB) { mark: none }
arrow sm11(ss11, se11) [ret]
label sl11(sm11, "candidate violates domain") { near: middle, side: above }
assert align_center_y(ss11, se11)
assert on(ss11, lifeC) and on(se11, lifeB)
point sr12 = translate(sr11, r1, r2) { mark: none }
point ss12 = foot(sr12, lifeB) { mark: none }
point se12 = foot(sr12, lifeC) { mark: none }
arrow sm12(ss12, se12) [main]
label sl12(sm12, "reject trial; increase damping") { near: middle, side: above }
assert align_center_y(ss12, se12)
assert on(ss12, lifeB) and on(se12, lifeC)
point sr13 = translate(sr12, r1, r2) { mark: none }
point ss13 = foot(sr13, lifeC) { mark: none }
point se13 = foot(sr13, lifeB) { mark: none }
arrow sm13(ss13, se13) [ret]
label sl13(sm13, "accepted state and rank") { near: middle, side: above }
assert align_center_y(ss13, se13)
assert on(ss13, lifeC) and on(se13, lifeB)
point sr14 = translate(sr13, r1, r2) { mark: none }
point ss14 = foot(sr14, lifeB) { mark: none }
point se14 = foot(sr14, lifeD) { mark: none }
arrow sm14(ss14, se14) [main]
label sl14(sm14, "persist solved report") { near: middle, side: above }
assert align_center_y(ss14, se14)
assert on(ss14, lifeB) and on(se14, lifeD)
point sr15 = translate(sr14, r1, r2) { mark: none }
point ss15 = foot(sr15, lifeD) { mark: none }
point se15 = foot(sr15, lifeB) { mark: none }
arrow sm15(ss15, se15) [ret]
label sl15(sm15, "commit acknowledged") { near: middle, side: above }
assert align_center_y(ss15, se15)
assert on(ss15, lifeD) and on(se15, lifeB)
point sr16 = translate(sr15, r1, r2) { mark: none }
point ss16 = foot(sr16, lifeB) { mark: none }
point se16 = foot(sr16, lifeC) { mark: none }
arrow sm16(ss16, se16) [main]
label sl16(sm16, "evaluate derived assertions") { near: middle, side: above }
assert align_center_y(ss16, se16)
assert on(ss16, lifeB) and on(se16, lifeC)
point sr17 = translate(sr16, r1, r2) { mark: none }
point ss17 = foot(sr17, lifeC) { mark: none }
point se17 = foot(sr17, lifeB) { mark: none }
arrow sm17(ss17, se17) [ret]
label sl17(sm17, "all assertions pass") { near: middle, side: above }
assert align_center_y(ss17, se17)
assert on(ss17, lifeC) and on(se17, lifeB)
point sr18 = translate(sr17, r1, r2) { mark: none }
point ss18 = foot(sr18, lifeB) { mark: none }
point se18 = sr18 { mark: none }
arrow sm18(ss18, se18) [ret]
label sl18(sm18, "check exit 0") { near: middle, side: above }
assert align_center_y(ss18, se18)
assert on(ss18, lifeB) and on(se18, lifeA)
point sr19 = translate(sr18, r1, r2) { mark: none }
point ss19 = sr19 { mark: none }
point se19 = foot(sr19, lifeB) { mark: none }
arrow sm19(ss19, se19) [main]
label sl19(sm19, "render SVG and TikZ") { near: middle, side: above }
assert align_center_y(ss19, se19)
assert on(ss19, lifeA) and on(se19, lifeB)
point sr20 = translate(sr19, r1, r2) { mark: none }
point ss20 = foot(sr20, lifeB) { mark: none }
point se20 = foot(sr20, lifeC) { mark: none }
arrow sm20(ss20, se20) [main]
label sl20(sm20, "measure and place labels") { near: middle, side: above }
assert align_center_y(ss20, se20)
assert on(ss20, lifeB) and on(se20, lifeC)
point sr21 = translate(sr20, r1, r2) { mark: none }
point ss21 = foot(sr21, lifeC) { mark: none }
point se21 = foot(sr21, lifeB) { mark: none }
arrow sm21(ss21, se21) [ret]
label sl21(sm21, "layout and collisions") { near: middle, side: above }
assert align_center_y(ss21, se21)
assert on(ss21, lifeC) and on(se21, lifeB)
point sr22 = translate(sr21, r1, r2) { mark: none }
point ss22 = foot(sr22, lifeB) { mark: none }
point se22 = foot(sr22, lifeD) { mark: none }
arrow sm22(ss22, se22) [main]
label sl22(sm22, "write SVG artifact") { near: middle, side: above }
assert align_center_y(ss22, se22)
assert on(ss22, lifeB) and on(se22, lifeD)
point sr23 = translate(sr22, r1, r2) { mark: none }
point ss23 = foot(sr23, lifeD) { mark: none }
point se23 = foot(sr23, lifeB) { mark: none }
arrow sm23(ss23, se23) [ret]
label sl23(sm23, "artifact hash") { near: middle, side: above }
assert align_center_y(ss23, se23)
assert on(ss23, lifeD) and on(se23, lifeB)
point sr24 = translate(sr23, r1, r2) { mark: none }
point ss24 = foot(sr24, lifeB) { mark: none }
point se24 = foot(sr24, lifeD) { mark: none }
arrow sm24(ss24, se24) [main]
label sl24(sm24, "write TikZ artifact") { near: middle, side: above }
assert align_center_y(ss24, se24)
assert on(ss24, lifeB) and on(se24, lifeD)
point sr25 = translate(sr24, r1, r2) { mark: none }
point ss25 = foot(sr25, lifeD) { mark: none }
point se25 = foot(sr25, lifeB) { mark: none }
arrow sm25(ss25, se25) [ret]
label sl25(sm25, "artifact hash") { near: middle, side: above }
assert align_center_y(ss25, se25)
assert on(ss25, lifeD) and on(se25, lifeB)
point sr26 = translate(sr25, r1, r2) { mark: none }
point ss26 = foot(sr26, lifeB) { mark: none }
point se26 = sr26 { mark: none }
arrow sm26(ss26, se26) [ret]
label sl26(sm26, "render complete") { near: middle, side: above }
assert align_center_y(ss26, se26)
assert on(ss26, lifeB) and on(se26, lifeA)
assert vdist(sr26, sr7) == 19 * vdist(sr8, sr7)


// Layout owns guide length, header spacing, and message row spacing.
rel row(boxA, boxB, boxC, boxD)
rel align_center_y(endA, endB, endC, endD)
rel gap_y(boxA, m1, m2, m3, m4, m5, m6, sm7, sm8, sm9, sm10, sm11, sm12, sm13, sm14, sm15, sm16, sm17, sm18, sm19, sm20, sm21, sm22, sm23, sm24, sm25, sm26, endA)
rel vdist(r2, r1) == vdist(r3, r2)


// Captions keep clear of the guides; their measured bounds set message spacing.
rel avoid(l1, lifeA, lifeB)
rel avoid(l2, lifeB, lifeC)
rel avoid(l3, lifeB, lifeC)
rel avoid(l4, lifeB, lifeC)
rel avoid(l5, lifeB, lifeC)
rel avoid(l6, lifeA, lifeB)
rel avoid(sl7, lifeA, lifeB)
rel avoid(sl8, lifeB, lifeC)
rel avoid(sl9, lifeC, lifeD)
rel avoid(sl10, lifeD, lifeC)
rel avoid(sl11, lifeC, lifeB)
rel avoid(sl12, lifeB, lifeC)
rel avoid(sl13, lifeC, lifeB)
rel avoid(sl14, lifeB, lifeD)
rel avoid(sl15, lifeD, lifeB)
rel avoid(sl16, lifeB, lifeC)
rel avoid(sl17, lifeC, lifeB)
rel avoid(sl18, lifeB, lifeA)
rel avoid(sl19, lifeA, lifeB)
rel avoid(sl20, lifeB, lifeC)
rel avoid(sl21, lifeC, lifeB)
rel avoid(sl22, lifeB, lifeD)
rel avoid(sl23, lifeD, lifeB)
rel avoid(sl24, lifeB, lifeD)
rel avoid(sl25, lifeD, lifeB)
rel avoid(sl26, lifeB, lifeA)

// ---- beta 6 specification acceptance: generic sequence composition ----
fn beta6_header(text) {
    rect shape()
    label caption(text)
    rel center(caption, shape)
    rel contain(shape, caption)
}

fn beta6_guide(start) {
    point finish() { mark: none }
    rel align_center_x(start, finish)
    rel gap_y(start, finish)
    segment path(start, finish) [lifeline]
}

fn beta6_message(source, target, text) {
    point tail() { mark: none }
    point tip() { mark: none }
    rel on(tail, source)
    rel on(tip, target)
    rel align_center_y(tail, tip)
    arrow path(tail, tip)
    label caption(path, text) { near: middle, side: above }
    rel avoid(caption, source, target)
    assert on(tail, source) and on(tip, target)
    assert path.length == dist(tail, tip)
}

fn beta6_loop(guide, text) {
    point tail() { mark: none }
    point tip() { mark: none }
    rel on(tail, guide)
    rel on(tip, guide)
    rel gap_y(tail, tip)
    arrow path(tail, tip) { route: orthogonal, side: right }
    label caption(path, text) { near: middle, side: right }
    rel avoid(caption, guide)
    assert on(tail, guide) and on(tip, guide)
    assert path.length > dist(tail, tip)
}

fn beta6_overlay(guide, paths) {
    rect shape() [highlight]
    rel align_center_x(shape, guide)
    rel shape.width == style_metric("narrow_width")
    rel cover_y(shape, paths)
    rel trim_endpoints(paths, shape)
    assert shape.width == style_metric("narrow_width")
    assert shape.height > 0
}

fn beta6_key(text, appearance) {
    point tail() { mark: none }
    point tip() { mark: none }
    rel align_center_y(tail, tip)
    rel gap_x(tail, tip)
    arrow sample(tail, tip) [appearance]
    rel sample.length == style_metric("short_length")
    label caption(text) [appearance]
    rel row(sample, caption)
    assert sample.length == style_metric("short_length")
}

beta6_header beta6_agent("Caller")
beta6_header beta6_kernel("Measured service endpoint")
group beta6_headers(beta6_agent, beta6_kernel)
rel row(beta6_headers)
rel gap_y(lifeA, beta6_headers)
rel align_left(boxA, beta6_headers)
beta6_guide beta6_source(beta6_agent.shape.s)
beta6_guide beta6_target(beta6_kernel.shape.s)
beta6_message beta6_request(beta6_source.path, beta6_target.path, "A long request caption determines the guide spacing")
beta6_loop beta6_work(beta6_target.path, "Local processing")
beta6_message beta6_reply(beta6_target.path, beta6_source.path, "Measured response") [ret]
group beta6_events(beta6_request, beta6_work, beta6_reply)
rect beta6_frame() [auxiliary]
rel contain(beta6_frame, beta6_events)
rel gap_y(beta6_headers, beta6_frame)
rect beta6_tab()
label beta6_tab_text("generic block")
rel center(beta6_tab_text, beta6_tab)
rel contain(beta6_tab, beta6_tab_text)
rel inset_left(beta6_tab, beta6_frame) { padding: none }
rel inset_top(beta6_tab, beta6_frame) { padding: none }
rel gap_y(beta6_tab, beta6_events)

point beta6_divider_left() { mark: none }
point beta6_divider_right() { mark: none }
rel on(beta6_divider_left, edge(beta6_frame, W))
rel on(beta6_divider_right, edge(beta6_frame, E))
rel align_center_y(beta6_divider_left, beta6_divider_right)
segment beta6_divider(beta6_divider_left, beta6_divider_right) [auxiliary]
rel gap_y(beta6_request, beta6_divider, beta6_work, beta6_reply)
rel align_center_y(beta6_source.finish, beta6_target.finish)
rel gap_y(beta6_events, beta6_source.finish)

// Pass an existing group into a function; original guides are not copied.
group beta6_clipped(beta6_request.path, beta6_reply.path)
beta6_overlay beta6_band(beta6_target.path, beta6_clipped)
rel gap_x(beta6_source.path, beta6_band.shape)
beta6_key beta6_legend("Dashed return", ret)
rel gap_y(beta6_frame, beta6_legend)
rel align_left(beta6_frame, beta6_legend)
assert align_center_y(beta6_agent.shape, beta6_kernel.shape)
assert contain(beta6_frame, beta6_events)
assert contain(beta6_tab, beta6_tab_text)
assert on(beta6_divider_left, edge(beta6_frame, W)) and on(beta6_divider_right, edge(beta6_frame, E))

// Keep the authored uniform rhythm while allowing layout to choose its size.
rel vdist(sr9, sr8) == vdist(sr8, sr7)
rel vdist(sr10, sr9) == vdist(sr8, sr7)
rel vdist(sr11, sr10) == vdist(sr8, sr7)
rel vdist(sr12, sr11) == vdist(sr8, sr7)
rel vdist(sr13, sr12) == vdist(sr8, sr7)
rel vdist(sr14, sr13) == vdist(sr8, sr7)
rel vdist(sr15, sr14) == vdist(sr8, sr7)
rel vdist(sr16, sr15) == vdist(sr8, sr7)
rel vdist(sr17, sr16) == vdist(sr8, sr7)
rel vdist(sr18, sr17) == vdist(sr8, sr7)
rel vdist(sr19, sr18) == vdist(sr8, sr7)
rel vdist(sr20, sr19) == vdist(sr8, sr7)
rel vdist(sr21, sr20) == vdist(sr8, sr7)
rel vdist(sr22, sr21) == vdist(sr8, sr7)
rel vdist(sr23, sr22) == vdist(sr8, sr7)
rel vdist(sr24, sr23) == vdist(sr8, sr7)
rel vdist(sr25, sr24) == vdist(sr8, sr7)
rel vdist(sr26, sr25) == vdist(sr8, sr7)
