assert length(stem0_12) == 0.295
point coeff0_13 = on_circle(circle(lerp(f0.sw, f0.se, 0.84375), 0.195), 90deg) { mark: none }
segment stem0_13(foot(coeff0_13, seg(f0.sw, f0.se)), coeff0_13) [coeff]
