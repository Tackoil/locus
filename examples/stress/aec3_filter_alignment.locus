point delay3 = foot(coeff3_14, seg(A0, A512)) { mark: none }
segment delayline3(coeff3_14, delay3) [peakln]
num delay_value3 = hdist(A0, delay3)
assert delay_value3 == hdist(A0, f3.w) + hdist(f3.w, coeff3_14)
point coeff4_0 = on_circle(circle(lerp(f4.sw, f4.se, 0.03125), 0.145), 90deg) { mark: none }
