point delay4 = foot(coeff4_1, seg(A0, A512)) { mark: none }
segment delayline4(coeff4_1, delay4) [peakln]
num delay_value4 = hdist(A0, delay4)
assert delay_value4 == hdist(A0, f4.w) + hdist(f4.w, coeff4_1)
num delay_min = min(min(delay_value0, delay_value1), min(delay_value3, delay_value4))
num delay_max = max(max(delay_value0, delay_value1), max(delay_value3, delay_value4))
rect delay_range() [overlap]
rel delay_range.width == delay_max - delay_min
rel delay_range.height == 0.7
rel hdist(A0, delay_range.w) == delay_min
rel gap_y(coefficient_legend, delay_range)
label delay_summary(delay_range.center, "Range of candidate delays across filter banks") { dir: center }
assert delay_value0 >= delay_min and delay_value0 <= delay_max
assert delay_value1 >= delay_min and delay_value1 <= delay_max
assert delay_value3 >= delay_min and delay_value3 <= delay_max
assert delay_value4 >= delay_min and delay_value4 <= delay_max
