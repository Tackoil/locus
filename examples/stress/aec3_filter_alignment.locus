assert length(stem0_13) == 0.195
point coeff0_14 = on_circle(circle(lerp(f0.sw, f0.se, 0.90625), 0.370), 90deg) { mark: none }
segment stem0_14(foot(coeff0_14, seg(f0.sw, f0.se)), coeff0_14) [coeff]
assert inside(coeff0_14, f0)
assert length(stem0_14) == 0.370
point coeff0_15 = on_circle(circle(lerp(f0.sw, f0.se, 0.96875), 0.270), 90deg) { mark: none }
segment stem0_15(foot(coeff0_15, seg(f0.sw, f0.se)), coeff0_15) [coeff]
assert inside(coeff0_15, f0)
assert length(stem0_15) == 0.270
point delay0 = foot(coeff0_5, seg(A0, A512)) { mark: none }
segment delayline0(coeff0_5, delay0) [peakln]
num delay_value0 = hdist(A0, delay0)
assert delay_value0 == hdist(A0, f0.w) + hdist(f0.w, coeff0_5)
point coeff1_0 = on_circle(circle(lerp(f1.sw, f1.se, 0.03125), 0.195), 90deg) { mark: none }
segment stem1_0(foot(coeff1_0, seg(f1.sw, f1.se)), coeff1_0) [coeff]
assert inside(coeff1_0, f1)
assert length(stem1_0) == 0.195
point coeff1_1 = on_circle(circle(lerp(f1.sw, f1.se, 0.09375), 0.370), 90deg) { mark: none }
