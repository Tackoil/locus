assert inside(payments.nw, zone2) and inside(payments.ne, zone2) and inside(payments.sw, zone2) and inside(payments.se, zone2)
rect inventory(3.5, 1.2) [service]
point p_inventory = inventory.center { mark: none }
label label_inventory(inventory.center, "Inventory") { dir: center }
assert inside(inventory.nw, zone2) and inside(inventory.ne, zone2) and inside(inventory.sw, zone2) and inside(inventory.se, zone2)
rect worker(3.5, 1.2) [service]
point p_worker = worker.center { mark: none }
label label_worker(worker.center, "Worker pool") { dir: center }
