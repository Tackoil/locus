line diagonal(offset(O, -4 * unit, -4 * unit), offset(O, 4 * unit, 4 * unit)) [construction]
// Positive radial magnitudes select the two branches on opposite rays.
num positive_span = free 1.1
num negative_span = free 0.9
point fixed_positive = offset(O, sqrt(positive_span * positive_span) * unit, sqrt(positive_span * positive_span) * unit)
point fixed_negative = offset(O, -sqrt(negative_span * negative_span) * unit, -sqrt(negative_span * negative_span) * unit)
rel hdist(O, fixed_positive) * vdist(O, fixed_positive) == unit * unit
rel hdist(O, fixed_negative) * vdist(O, fixed_negative) == unit * unit
assert center(fixed_positive, P3)
assert center(fixed_negative, N3)
line tangent_positive(offset(O, 0, 2 * unit), offset(O, 2 * unit, 0)) [auxiliary]
line tangent_negative(offset(O, 0, -2 * unit), offset(O, -2 * unit, 0)) [auxiliary]
assert on(fixed_positive, tangent_positive) and on(fixed_negative, tangent_negative)
assert perpendicular(tangent_positive, diagonal)
assert parallel(tangent_positive, tangent_negative)
