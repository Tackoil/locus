segment rns2(rn1, rn2) [curve]
assert vdist(O, rp2) < vdist(O, rp1)
assert vdist(rp1, rp2) / hdist(rp1, rp2) == -unit * unit / (hdist(O, rp1) * hdist(O, rp2))
