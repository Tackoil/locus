locus 0 beta 6

meta title = "X-Y stress plot: reciprocal branches, fixed points, and tangent lines"
meta note = "130 samples on [-4, -0.25] and [0.25, 4]; nonlinear fixed points and secant slopes are checked. No segment crosses x = 0."

style textbook
class curve { accent: teal, weight: 2, cap: round }

point O() { mark: none }
num unit = 1
arrow x_axis(offset(O, -4.5 * unit, 0), offset(O, 4.5 * unit, 0))
arrow y_axis(offset(O, 0, -4.5 * unit), offset(O, 0, 4.5 * unit))
label lx(offset(O, 4.5 * unit, 0), "x") { dir: E }
label ly(offset(O, 0, 4.5 * unit), "y") { dir: N }

point P1 = offset(O, 0.25 * unit, unit / 0.25) { mark: none }
point P2 = offset(O, 0.5 * unit, unit / 0.5) { mark: none }
point P3 = offset(O, unit, unit) { mark: none }
point P4 = offset(O, 2 * unit, unit / 2) { mark: none }
point P5 = offset(O, 4 * unit, unit / 4) { mark: none }
point N1 = reflect(P1, O) { mark: none }
point N2 = reflect(P2, O) { mark: none }
point N3 = reflect(P3, O) { mark: none }
point N4 = reflect(P4, O) { mark: none }
point N5 = reflect(P5, O) { mark: none }
label lp(P3, "(1, 1)") { dir: NE }
label ln(N3, "(-1, -1)") { dir: SW }
text_block caption("y = 1 / x (sampled); x = 0 excluded") { place: below }

assert hdist(O, P1) * vdist(O, P1) == unit * unit
assert hdist(O, P2) * vdist(O, P2) == unit * unit
assert hdist(O, P3) * vdist(O, P3) == unit * unit
assert hdist(O, P4) * vdist(O, P4) == unit * unit
assert hdist(O, P5) * vdist(O, P5) == unit * unit
assert hdist(O, N2) * vdist(O, N2) == unit * unit
assert hdist(O, N5) * vdist(O, N5) == unit * unit
assert center(midpoint(P1, N1), O)
assert hdist(O, P1) > 0 and hdist(O, N1) < 0
assert vdist(O, P1) > vdist(O, P2) and vdist(O, P4) > vdist(O, P5)

// ---- stress construction network ----
// 130 samples stay in their respective quadrants; secant slopes approach the tangent.
point rp0 = offset(O, 0.2500000000 * unit, unit / 0.2500000000) { mark: none }
point rn0 = reflect(rp0, O) { mark: none }
assert hdist(O, rp0) > 0 and hdist(O, rn0) < 0
assert hdist(O, rp0) * vdist(O, rp0) == unit * unit
point rp1 = offset(O, 0.3085937500 * unit, unit / 0.3085937500) { mark: none }
point rn1 = reflect(rp1, O) { mark: none }
assert hdist(O, rp1) > 0 and hdist(O, rn1) < 0
assert hdist(O, rp1) * vdist(O, rp1) == unit * unit
segment rps1(rp0, rp1) [curve]
segment rns1(rn0, rn1) [curve]
assert vdist(O, rp1) < vdist(O, rp0)
assert vdist(rp0, rp1) / hdist(rp0, rp1) == -unit * unit / (hdist(O, rp0) * hdist(O, rp1))
point rp2 = offset(O, 0.3671875000 * unit, unit / 0.3671875000) { mark: none }
