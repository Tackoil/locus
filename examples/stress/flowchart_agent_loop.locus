locus 0 beta 6

meta title = "Agent workflow: never render until check passes"
meta note = "0 beta 6 shape-owned nodes and anchor relations define the spine and fix branch"

style textbook

// ---- sizing constants --------------------------------------
num bw    = 3.4        // box width
num bh    = 1.1        // box height
num pitch = 2.3        // vertical center-to-center pitch
num side  = 5.6        // offset to the fix branch

// ---- spine nodes --------------------------------------------
rect n1(bw, bh)
point N1 = n1.center { mark: none }
label t1(n1.center, "locus init")  { dir: center }

rect n2(bw, bh) where { align_center_x(N1, n2.center), vdist(n2.center, N1) == pitch }
point N2 = n2.center { mark: none }
label t2(n2.center, "locus add < ops.locus")  { dir: center }

rect n3(bw, bh) where { align_center_x(N2, n3.center), vdist(n3.center, N2) == pitch }
point N3 = n3.center { mark: none }
label t3(n3.center, "locus check")  { dir: center }

diamond n4(3.2, 1.5) where { align_center_x(N3, n4.center), vdist(n4.center, N3) == pitch }
point N4 = n4.center { mark: none }
label t4(n4.center, "exit 0?")  { dir: center }

rect n5(bw, bh) where { align_center_x(N4, n5.center), vdist(n5.center, N4) == pitch }   [highlight]
point N5 = n5.center { mark: none }
label t5(n5.center, "locus render -o fig.svg")  { dir: center }

// ---- side node: fix ------------------------------------------
rect nf(bw, bh) where { align_center_y(N4, nf.center), hdist(N4, nf.center) == side }
point NF = nf.center { mark: none }
label tf(nf.center, "fix ops (update / edit)")  { dir: center }

// ---- edges ----------------------------------------------------
arrow a1(n1.s, n2.n)  { head: -> }
arrow a2(n2.s, n3.n)  { head: -> }
arrow a3(n3.s, n4.n)  { head: -> }
arrow a4(n4.s, n5.n)  { head: -> }
label ly(n4.s, "yes")  { dir: SW, gap: 0.15 }
arrow a5(n4.e, nf.w)  { head: -> }
label ln(n4.e, "no")   { dir: NE, gap: 0.15 }
arrow a6(nf.n, n2.e)  { head: ->, bend: 40deg }

// ---- layout invariants — the Locus payoff ---------------------
assert collinear(N1, N2, N3, N4, N5)               // spine
assert vdist(N2, N1) == vdist(N3, N2)              // equal pitch
assert n1.width == n3.width                        // equal widths
assert align_center_y(N4, NF)                          // fix branch on the decision row

// ---- stress construction network ----
// The original authoring loop expands into solver, rejection, and export branches.
point stage0 = offset(N5, 0.0, -3) { mark: none }
rect state0(stage0, 4.5, 1.4)
label title0(state0.center, "Validate schema") { dir: center }
assert state0.width == 4.5
point stage1 = offset(N5, 5.6, -3) { mark: none }
diamond state1(stage1, 4.5, 1.4)
label title1(state1.center, "Inputs valid?") { dir: center }
assert state1.width == 4.5
point stage2 = offset(N5, 11.2, -3) { mark: none }
rect state2(stage2, 4.5, 1.4)
label title2(state2.center, "Select branch") { dir: center }
assert state2.width == 4.5
point stage3 = offset(N5, 16.799999999999997, -3) { mark: none }
rect state3(stage3, 4.5, 1.4)
label title3(state3.center, "Build Jacobian") { dir: center }
assert state3.width == 4.5
point stage4 = offset(N5, 0.0, -6) { mark: none }
rect state4(stage4, 4.5, 1.4)
label title4(state4.center, "Measure residual") { dir: center }
assert state4.width == 4.5
point stage5 = offset(N5, 5.6, -6) { mark: none }
diamond state5(stage5, 4.5, 1.4)
label title5(state5.center, "Converged?") { dir: center }
assert state5.width == 4.5
point stage6 = offset(N5, 11.2, -6) { mark: none }
rect state6(stage6, 4.5, 1.4)
label title6(state6.center, "Try LM step") { dir: center }
assert state6.width == 4.5
point stage7 = offset(N5, 16.799999999999997, -6) { mark: none }
diamond state7(stage7, 4.5, 1.4)
label title7(state7.center, "Domain valid?") { dir: center }
assert state7.width == 4.5
point stage8 = offset(N5, 0.0, -9) { mark: none }
diamond state8(stage8, 4.5, 1.4)
label title8(state8.center, "Accept trial?") { dir: center }
assert state8.width == 4.5
point stage9 = offset(N5, 5.6, -9) { mark: none }
rect state9(stage9, 4.5, 1.4)
label title9(state9.center, "Lower damping") { dir: center }
assert state9.width == 4.5
point stage10 = offset(N5, 11.2, -9) { mark: none }
rect state10(stage10, 4.5, 1.4)
label title10(state10.center, "Raise damping") { dir: center }
assert state10.width == 4.5
point stage11 = offset(N5, 16.799999999999997, -9) { mark: none }
diamond state11(stage11, 4.5, 1.4)
label title11(state11.center, "Budget left?") { dir: center }
assert state11.width == 4.5
point stage12 = offset(N5, 0.0, -12) { mark: none }
rect state12(stage12, 4.5, 1.4)
label title12(state12.center, "Check assertions") { dir: center }
assert state12.width == 4.5
point stage13 = offset(N5, 5.6, -12) { mark: none }
diamond state13(stage13, 4.5, 1.4)
label title13(state13.center, "Assertions pass?") { dir: center }
assert state13.width == 4.5
point stage14 = offset(N5, 11.2, -12) { mark: none }
rect state14(stage14, 4.5, 1.4)
label title14(state14.center, "Render outputs") { dir: center }
assert state14.width == 4.5
point stage15 = offset(N5, 16.799999999999997, -12) { mark: none }
rect state15(stage15, 4.5, 1.4)
label title15(state15.center, "Report failure") { dir: center }
assert state15.width == 4.5
arrow solver_edge0(state0.s, state1.n) { bend: -18deg }
arrow solver_edge1(state1.s, state2.n) { bend: 0deg }
arrow solver_edge2(state1.s, state15.n) { bend: 18deg }
arrow solver_edge3(state2.s, state3.n) { bend: -18deg }
arrow solver_edge4(state3.s, state4.n) { bend: 0deg }
arrow solver_edge5(state4.s, state5.n) { bend: 18deg }
arrow solver_edge6(state5.s, state12.n) { bend: -18deg }
arrow solver_edge7(state5.s, state6.n) { bend: 0deg }
arrow solver_edge8(state6.s, state7.n) { bend: 18deg }
arrow solver_edge9(state7.s, state8.n) { bend: -18deg }
arrow solver_edge10(state7.s, state10.n) { bend: 0deg }
arrow solver_edge11(state8.s, state9.n) { bend: 18deg }
arrow solver_edge12(state8.s, state10.n) { bend: -18deg }
arrow solver_edge13(state9.s, state4.n) { bend: 0deg }
arrow solver_edge14(state10.s, state11.n) { bend: 18deg }
arrow solver_edge15(state11.s, state6.n) { bend: -18deg }
arrow solver_edge16(state11.s, state15.n) { bend: 0deg }
arrow solver_edge17(state12.s, state13.n) { bend: 18deg }
arrow solver_edge18(state13.s, state14.n) { bend: -18deg }
arrow solver_edge19(state13.s, state15.n) { bend: 0deg }
arrow enter_solver(n3.e, state0.w) [construction] { bend: -25deg }
assert collinear(stage0, stage1, stage2, stage3)
assert collinear(stage4, stage5, stage6, stage7)
assert collinear(stage8, stage9, stage10, stage11)
assert collinear(stage12, stage13, stage14, stage15)
assert collinear(stage0, stage4, stage8, stage12)
assert collinear(stage1, stage5, stage9, stage13)
assert collinear(stage2, stage6, stage10, stage14)
assert collinear(stage3, stage7, stage11, stage15)

// ---- beta 6 specification acceptance: composition and measured layout ----
// Explicit geometry above is retained; this panel exercises engine-owned sizes.
fn beta6_step(text, appearance) {
    rounded_rect shape() [appearance]
    label caption(text) [main]
    rel center(caption, shape)
    rel contain(shape, caption)
}

fn beta6_pair(first_text, second_text) {
    beta6_step first(first_text, main)
    beta6_step second(second_text, highlight)
    group stages(first, second)
    group repeated(stages, first, second)
    rel column(stages)
    rel second.shape.width == first.shape.width
    rel second.shape.height == first.shape.height

    // Clip center-to-center paths without changing their logical measurements.
    arrow forward(first.shape.center, second.shape.center)
    label next(forward, "advance") { near: middle, side: left }
    rel trim_endpoints(forward, first.shape)
    rel trim_endpoints(forward, second.shape)
    arrow back(second.shape.e, first.shape.e) { route: orthogonal, side: right }
    label retry(back, "retry") { near: middle, side: right }
    rel avoid(back, first.shape, second.shape, forward)

    assert center(repeated, stages)
    assert contain(first.shape, first.caption) and contain(second.shape, second.caption)
    assert align_center_x(first, second)
    assert first.shape.width == second.shape.width and first.shape.height == second.shape.height
    assert forward.length == dist(first.shape.center, second.shape.center)
    assert on(first.shape.e, first.shape) and on(second.shape.e, second.shape)
}

beta6_pair beta6_pair0("State 0", "A measured retry caption for state 0")
beta6_pair beta6_pair1("State 1", "A measured retry caption for state 1") [construction]
beta6_pair beta6_pair2("State 2", "A measured retry caption for state 2")
beta6_pair beta6_pair3("State 3", "A measured retry caption for state 3") [construction]
beta6_pair beta6_pair4("State 4", "A measured retry caption for state 4")
beta6_pair beta6_pair5("State 5", "A measured retry caption for state 5") [construction]
beta6_pair beta6_pair6("State 6", "A measured retry caption for state 6")
beta6_pair beta6_pair7("State 7", "A measured retry caption for state 7") [construction]
beta6_pair beta6_pair8("State 8", "A measured retry caption for state 8")
beta6_pair beta6_pair9("State 9", "A measured retry caption for state 9") [construction]
beta6_pair beta6_pair10("State 10", "A measured retry caption for state 10")
beta6_pair beta6_pair11("State 11", "A measured retry caption for state 11") [construction]
beta6_pair beta6_pair12("State 12", "A measured retry caption for state 12")
beta6_pair beta6_pair13("State 13", "A measured retry caption for state 13") [construction]
beta6_pair beta6_pair14("State 14", "A measured retry caption for state 14")
beta6_pair beta6_pair15("State 15", "A measured retry caption for state 15") [construction]
group beta6_row0(beta6_pair0, beta6_pair1, beta6_pair2, beta6_pair3)
rel row(beta6_row0)
group beta6_row1(beta6_pair4, beta6_pair5, beta6_pair6, beta6_pair7)
rel row(beta6_row1)
group beta6_row2(beta6_pair8, beta6_pair9, beta6_pair10, beta6_pair11)
rel row(beta6_row2)
group beta6_row3(beta6_pair12, beta6_pair13, beta6_pair14, beta6_pair15)
rel row(beta6_row3)
group beta6_first_rows(beta6_row0, beta6_row1)
group beta6_grid(beta6_first_rows, beta6_row2, beta6_row3)
group beta6_duplicates(beta6_grid, beta6_pair0, beta6_pair15)
rel gap_y(beta6_row0, beta6_row1, beta6_row2, beta6_row3)
rel align_left(beta6_row0, beta6_row1, beta6_row2, beta6_row3)
rel gap_y(state15, beta6_grid)
rel align_left(state0, beta6_grid)
assert center(beta6_duplicates, beta6_grid)
