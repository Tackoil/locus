assert flow0_0_0 + flow0_1_0 + flow0_2_0 == flow1_0_0 + flow1_0_1 + flow1_0_2 + flow1_0_3
assert node1_0.height / scale == flow0_0_0 + flow0_1_0 + flow0_2_0
assert flow0_0_1 + flow0_1_1 + flow0_2_1 == flow1_1_0 + flow1_1_1 + flow1_1_2 + flow1_1_3
assert node1_1.height / scale == flow0_0_1 + flow0_1_1 + flow0_2_1
assert flow0_0_2 + flow0_1_2 + flow0_2_2 == flow1_2_0 + flow1_2_1 + flow1_2_2 + flow1_2_3
assert node1_2.height / scale == flow0_0_2 + flow0_1_2 + flow0_2_2
assert flow0_0_3 + flow0_1_3 + flow0_2_3 == flow1_3_0 + flow1_3_1 + flow1_3_2 + flow1_3_3
assert node1_3.height / scale == flow0_0_3 + flow0_1_3 + flow0_2_3
assert node0_0.height + node0_1.height + node0_2.height == node2_0.height + node2_1.height + node2_2.height + node2_3.height
assert (node0_0.height + node0_1.height + node0_2.height) / scale == 100
