locus 0 beta 6

meta title = "Conserved flow network: three sources, four processes, four outputs"
meta note = "Twenty-eight weighted polygon bands split and merge across two stages. Thickness is measured vertically at ports."

style textbook

class node { accent: gray, fill: tint }
num scale = 0.12
class flow0 { accent: #14B8A6, fill: #14B8A6, opacity: 0.55 }
class flow1 { accent: #3B82F6, fill: #3B82F6, opacity: 0.55 }
class flow2 { accent: #F59E0B, fill: #F59E0B, opacity: 0.55 }
class flow3 { accent: #A855F7, fill: #A855F7, opacity: 0.55 }
// Node heights encode values; columns and gaps are chosen by layout.
num flow0_0_0 = 18
num flow0_0_1 = 12
num flow0_0_2 = 6
num flow0_0_3 = 4
num flow0_1_0 = 10
num flow0_1_1 = 8
num flow0_1_2 = 12
num flow0_1_3 = 5
num flow0_2_0 = 4
num flow0_2_1 = 6
num flow0_2_2 = 8
num flow0_2_3 = 7
num flow1_0_0 = 20
num flow1_0_1 = 6
num flow1_0_2 = 4
num flow1_0_3 = 2
num flow1_1_0 = 10
num flow1_1_1 = 10
num flow1_1_2 = 4
num flow1_1_3 = 2
num flow1_2_0 = 6
num flow1_2_1 = 8
num flow1_2_2 = 10
num flow1_2_3 = 2
num flow1_3_0 = 4
num flow1_3_1 = 4
num flow1_3_2 = 4
num flow1_3_3 = 4
rect node0_0(0.6, 40 * scale) [node]
point center0_0 = node0_0.center { mark: none }
label label0_0("Source 1: 40")
rel align_center_x(label0_0, node0_0)
rel gap_y(label0_0, node0_0)
rect node0_1(0.6, 35 * scale) [node]
point center0_1 = node0_1.center { mark: none }
label label0_1("Source 2: 35")
rel align_center_x(label0_1, node0_1)
rel gap_y(label0_1, node0_1)
rect node0_2(0.6, 25 * scale) [node]
point center0_2 = node0_2.center { mark: none }
label label0_2("Source 3: 25")
rel align_center_x(label0_2, node0_2)
rel gap_y(label0_2, node0_2)
rect node1_0(0.6, 32 * scale) [node]
point center1_0 = node1_0.center { mark: none }
label label1_0("Process 1: 32")
rel align_center_x(label1_0, node1_0)
rel gap_y(label1_0, node1_0)
rect node1_1(0.6, 26 * scale) [node]
point center1_1 = node1_1.center { mark: none }
label label1_1("Process 2: 26")
rel align_center_x(label1_1, node1_1)
rel gap_y(label1_1, node1_1)
rect node1_2(0.6, 26 * scale) [node]
point center1_2 = node1_2.center { mark: none }
label label1_2("Process 3: 26")
rel align_center_x(label1_2, node1_2)
rel gap_y(label1_2, node1_2)
rect node1_3(0.6, 16 * scale) [node]
point center1_3 = node1_3.center { mark: none }
label label1_3("Process 4: 16")
rel align_center_x(label1_3, node1_3)
rel gap_y(label1_3, node1_3)
rect node2_0(0.6, 40 * scale) [node]
point center2_0 = node2_0.center { mark: none }
label label2_0("Output 1: 40")
rel align_center_x(label2_0, node2_0)
rel gap_y(label2_0, node2_0)
rect node2_1(0.6, 28 * scale) [node]
point center2_1 = node2_1.center { mark: none }
label label2_1("Output 2: 28")
rel align_center_x(label2_1, node2_1)
rel gap_y(label2_1, node2_1)
rect node2_2(0.6, 22 * scale) [node]
point center2_2 = node2_2.center { mark: none }
label label2_2("Output 3: 22")
rel align_center_x(label2_2, node2_2)
rel gap_y(label2_2, node2_2)
rect node2_3(0.6, 10 * scale) [node]
point center2_3 = node2_3.center { mark: none }
label label2_3("Output 4: 10")
rel align_center_x(label2_3, node2_3)
rel gap_y(label2_3, node2_3)
group stage0(node0_0, label0_0, node0_1, label0_1, node0_2, label0_2)
rel column(node0_0, node0_1, node0_2)
group stage1(node1_0, label1_0, node1_1, label1_1, node1_2, label1_2, node1_3, label1_3)
rel column(node1_0, node1_1, node1_2, node1_3)
group stage2(node2_0, label2_0, node2_1, label2_1, node2_2, label2_2, node2_3, label2_3)
rel column(node2_0, node2_1, node2_2, node2_3)
rel gap_x(stage0, stage1, stage2)
rel align_top(stage0, stage1, stage2)
// Each heading belongs to its node's stage and clears the preceding node.
rel gap_y(node0_0, label0_1)
rel gap_y(node0_1, label0_2)
rel gap_y(node1_0, label1_1)
rel gap_y(node1_1, label1_2)
rel gap_y(node1_2, label1_3)
rel gap_y(node2_0, label2_1)
rel gap_y(node2_1, label2_2)
rel gap_y(node2_2, label2_3)

// Bands partition the incoming and outgoing edges in flow order.
point f0_0_0st = lerp(node0_0.ne, node0_0.se, (0) / 40) { mark: none }
point f0_0_0sb = lerp(node0_0.ne, node0_0.se, (flow0_0_0) / 40) { mark: none }
point f0_0_0tt = lerp(node1_0.nw, node1_0.sw, (0) / 32) { mark: none }
point f0_0_0tb = lerp(node1_0.nw, node1_0.sw, (flow0_0_0) / 32) { mark: none }
polygon f0_0_0band(f0_0_0sb, f0_0_0st, f0_0_0tt, f0_0_0tb) [flow0]
assert vdist(f0_0_0sb, f0_0_0st) / scale == 18
assert vdist(f0_0_0sb, f0_0_0st) == vdist(f0_0_0tb, f0_0_0tt)
assert area(f0_0_0band) == 18 * scale * hdist(f0_0_0st, f0_0_0tt)
point f0_0_1st = lerp(node0_0.ne, node0_0.se, (flow0_0_0) / 40) { mark: none }
point f0_0_1sb = lerp(node0_0.ne, node0_0.se, (flow0_0_0 + flow0_0_1) / 40) { mark: none }
point f0_0_1tt = lerp(node1_1.nw, node1_1.sw, (0) / 26) { mark: none }
point f0_0_1tb = lerp(node1_1.nw, node1_1.sw, (flow0_0_1) / 26) { mark: none }
polygon f0_0_1band(f0_0_1sb, f0_0_1st, f0_0_1tt, f0_0_1tb) [flow1]
assert vdist(f0_0_1sb, f0_0_1st) / scale == 12
assert vdist(f0_0_1sb, f0_0_1st) == vdist(f0_0_1tb, f0_0_1tt)
assert area(f0_0_1band) == 12 * scale * hdist(f0_0_1st, f0_0_1tt)
point f0_0_2st = lerp(node0_0.ne, node0_0.se, (flow0_0_0 + flow0_0_1) / 40) { mark: none }
point f0_0_2sb = lerp(node0_0.ne, node0_0.se, (flow0_0_0 + flow0_0_1 + flow0_0_2) / 40) { mark: none }
point f0_0_2tt = lerp(node1_2.nw, node1_2.sw, (0) / 26) { mark: none }
point f0_0_2tb = lerp(node1_2.nw, node1_2.sw, (flow0_0_2) / 26) { mark: none }
polygon f0_0_2band(f0_0_2sb, f0_0_2st, f0_0_2tt, f0_0_2tb) [flow2]
assert vdist(f0_0_2sb, f0_0_2st) / scale == 6
assert vdist(f0_0_2sb, f0_0_2st) == vdist(f0_0_2tb, f0_0_2tt)
assert area(f0_0_2band) == 6 * scale * hdist(f0_0_2st, f0_0_2tt)
point f0_0_3st = lerp(node0_0.ne, node0_0.se, (flow0_0_0 + flow0_0_1 + flow0_0_2) / 40) { mark: none }
point f0_0_3sb = lerp(node0_0.ne, node0_0.se, (flow0_0_0 + flow0_0_1 + flow0_0_2 + flow0_0_3) / 40) { mark: none }
point f0_0_3tt = lerp(node1_3.nw, node1_3.sw, (0) / 16) { mark: none }
point f0_0_3tb = lerp(node1_3.nw, node1_3.sw, (flow0_0_3) / 16) { mark: none }
polygon f0_0_3band(f0_0_3sb, f0_0_3st, f0_0_3tt, f0_0_3tb) [flow3]
assert vdist(f0_0_3sb, f0_0_3st) / scale == 4
assert vdist(f0_0_3sb, f0_0_3st) == vdist(f0_0_3tb, f0_0_3tt)
assert area(f0_0_3band) == 4 * scale * hdist(f0_0_3st, f0_0_3tt)
point f0_1_0st = lerp(node0_1.ne, node0_1.se, (0) / 35) { mark: none }
point f0_1_0sb = lerp(node0_1.ne, node0_1.se, (flow0_1_0) / 35) { mark: none }
