point f0_1_0tb = lerp(node1_0.nw, node1_0.sw, (flow0_0_0 + flow0_1_0) / 32) { mark: none }
polygon f0_1_0band(f0_1_0sb, f0_1_0st, f0_1_0tt, f0_1_0tb) [flow0]
assert vdist(f0_1_0sb, f0_1_0st) / scale == 10
