rel align_center_y(O, timeline_end)
rel hdist(O, timeline_end) == (release_day + 2) * day
arrow timeline(O, timeline_end)
point time0 = lerp(O, timeline_end, 0 / (release_day + 2)) { mark: none }
segment tick0(on_circle(circle(time0, 0.15), 270deg), on_circle(circle(time0, 0.15), 90deg))
label tick_label0(tick0.end, "0") { dir: N }
point time2 = lerp(O, timeline_end, 2 / (release_day + 2)) { mark: none }
segment tick2(on_circle(circle(time2, 0.15), 270deg), on_circle(circle(time2, 0.15), 90deg))
label tick_label2(tick2.end, "2") { dir: N }
point time4 = lerp(O, timeline_end, 4 / (release_day + 2)) { mark: none }
segment tick4(on_circle(circle(time4, 0.15), 270deg), on_circle(circle(time4, 0.15), 90deg))
label tick_label4(tick4.end, "4") { dir: N }
point time6 = lerp(O, timeline_end, 6 / (release_day + 2)) { mark: none }
segment tick6(on_circle(circle(time6, 0.15), 270deg), on_circle(circle(time6, 0.15), 90deg))
label tick_label6(tick6.end, "6") { dir: N }
point time8 = lerp(O, timeline_end, 8 / (release_day + 2)) { mark: none }
segment tick8(on_circle(circle(time8, 0.15), 270deg), on_circle(circle(time8, 0.15), 90deg))
label tick_label8(tick8.end, "8") { dir: N }
point time10 = lerp(O, timeline_end, 10 / (release_day + 2)) { mark: none }
segment tick10(on_circle(circle(time10, 0.15), 270deg), on_circle(circle(time10, 0.15), 90deg))
label tick_label10(tick10.end, "10") { dir: N }
point time12 = lerp(O, timeline_end, 12 / (release_day + 2)) { mark: none }
segment tick12(on_circle(circle(time12, 0.15), 270deg), on_circle(circle(time12, 0.15), 90deg))
label tick_label12(tick12.end, "12") { dir: N }
point time14 = lerp(O, timeline_end, 14 / (release_day + 2)) { mark: none }
segment tick14(on_circle(circle(time14, 0.15), 270deg), on_circle(circle(time14, 0.15), 90deg))
label tick_label14(tick14.end, "14") { dir: N }
point time16 = lerp(O, timeline_end, 16 / (release_day + 2)) { mark: none }
segment tick16(on_circle(circle(time16, 0.15), 270deg), on_circle(circle(time16, 0.15), 90deg))
label tick_label16(tick16.end, "16") { dir: N }
point time18 = lerp(O, timeline_end, 18 / (release_day + 2)) { mark: none }
segment tick18(on_circle(circle(time18, 0.15), 270deg), on_circle(circle(time18, 0.15), 90deg))
label tick_label18(tick18.end, "18") { dir: N }
point time20 = lerp(O, timeline_end, 20 / (release_day + 2)) { mark: none }
segment tick20(on_circle(circle(time20, 0.15), 270deg), on_circle(circle(time20, 0.15), 90deg))
label tick_label20(tick20.end, "20") { dir: N }
arrow gate0(task4_0.e, release.n) [dependency]
assert release_day >= finish4_0
arrow gate1(task4_1.e, release.n) [dependency]
assert release_day >= finish4_1
arrow gate2(task4_2.e, release.n) [dependency]
assert release_day >= finish4_2
arrow gate3(task4_3.e, release.n) [dependency]
assert release_day >= finish4_3
assert release_day == 18

// Time remains numeric; team/phase ordering supplies vertical placement.
rel gap_y(task0_0, task1_0, task2_0, task3_0, task4_0)
rel gap_y(task0_1, task1_1, task2_1, task3_1, task4_1)
rel gap_y(task0_2, task1_2, task2_2, task3_2, task4_2)
rel gap_y(task0_3, task1_3, task2_3, task3_3, task4_3)
rel gap_y(timeline, task0_0)
rel gap_y(task4_0, task0_1)
rel gap_y(task4_1, task0_2)
rel gap_y(task4_2, task0_3)
rel gap_y(task4_3, release)
