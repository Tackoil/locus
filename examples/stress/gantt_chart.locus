locus 0 beta 6

meta title = "Release schedule: twenty tasks, parallel teams, joins, and progress"
meta note = "Duration variables start away from their targets; max dependencies propagate through five phases to the release gate."

style textbook

class planned { accent: gray, stroke: dashed }
class actual { accent: blue, fill: tint }
class progress { accent: teal, fill: tint }
class dependency { accent: purple, stroke: dashed }
point O() { mark: none }
num day = 0.75
num duration0_0 = free 2.2
rel duration0_0 == 2
num start0_0 = 0
num finish0_0 = start0_0 + duration0_0
rect baseline0_0(2 * day, 0.8) [planned]
rel hdist(O, baseline0_0.w) == (1.00 * day) - (2 * day) / 2
rect task0_0(duration0_0 * day, 0.65) [actual]
rel hdist(O, task0_0.w) == start0_0 * day
rel align_center_y(baseline0_0, task0_0)
rect done0_0(task0_0.width * 1, 0.3) [progress]
rel center(done0_0.w, task0_0.w)
label task_label0_0(task0_0.w, "T1: Design") { dir: W }
assert task0_0.width / day == 2
assert hdist(O, task0_0.w) / day == 0
assert done0_0.width <= task0_0.width
assert center(done0_0.w, task0_0.w)
num duration0_1 = free 3.2
rel duration0_1 == 3
num start0_1 = 0
num finish0_1 = start0_1 + duration0_1
