board_lane2_3 cell2_3()
board_lane2_4 cell2_4()
label team0("Platform")
rel row(cell0_0, cell0_1, cell0_2, cell0_3, cell0_4)
rel gap_x(team0, cell0_0)
rel align_center_y(team0, cell0_0)
label team1("Web")
rel row(cell1_0, cell1_1, cell1_2, cell1_3, cell1_4)
rel gap_x(team1, cell1_0)
rel align_center_y(team1, cell1_0)
label team2("Data")
rel row(cell2_0, cell2_1, cell2_2, cell2_3, cell2_4)
rel gap_x(team2, cell2_0)
rel align_center_y(team2, cell2_0)
rel column(cell0_0, cell1_0, cell2_0)
rel column(cell0_1, cell1_1, cell2_1)
rel column(cell0_2, cell1_2, cell2_2)
rel column(cell0_3, cell1_3, cell2_3)
rel column(cell0_4, cell1_4, cell2_4)
arrow blocked_by(cell1_2.card1_2_0.n, cell0_2.card0_2_1.s) [construction] { bend: 25deg }
arrow review_dependency(cell2_3.card2_3_0.n, cell1_3.card1_3_1.s) [construction] { bend: -25deg }
num doing_count = cell0_2.card0_2_0.width / card_width + cell0_2.card0_2_1.width / card_width + cell1_2.card1_2_0.width / card_width + cell1_2.card1_2_1.width / card_width + cell1_2.card1_2_2.width / card_width + cell2_2.card2_2_0.width / card_width + cell2_2.card2_2_1.width / card_width
num wip_limit = 8
assert doing_count == 7
assert doing_count <= wip_limit
