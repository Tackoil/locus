locus 0 beta 6

meta title = "Delivery board: three teams, five states, cross-team blockers"
meta note = "Thirty-seven cards occupy fifteen cells; containment, WIP, stacking, and cross-lane dependencies are checked."

style textbook

class lane { accent: gray, fill: tint }
class pending { accent: blue, fill: tint }
class active { accent: orange, fill: tint }
class complete { accent: green, fill: tint }
class blocked { accent: red, fill: tint }
num card_width = 4.6
num card_height = 1.25
fn board_lane0_0() {
    rect lane0_0() [lane]
    label title0_0("Backlog (2)")
    rect card0_0_0(card_width, card_height) [pending]
    label text_card0_0_0("P-00: Search\nScope")
    rel center(text_card0_0_0, card0_0_0)
    assert inside(card0_0_0.nw, lane0_0) and inside(card0_0_0.ne, lane0_0) and inside(card0_0_0.sw, lane0_0) and inside(card0_0_0.se, lane0_0)
    rect card0_0_1(card_width, card_height) [pending]
    label text_card0_0_1("P-01: Export\nScope")
    rel center(text_card0_0_1, card0_0_1)
    assert inside(card0_0_1.nw, lane0_0) and inside(card0_0_1.ne, lane0_0) and inside(card0_0_1.sw, lane0_0) and inside(card0_0_1.se, lane0_0)
    assert gap_y(card0_0_0, card0_0_1)
    rel column(title0_0, card0_0_0, card0_0_1)
    group contents(title0_0, card0_0_0, card0_0_1)
    rel center(contents, lane0_0)
    rel contain(lane0_0, contents)
}

