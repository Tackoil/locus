locus 0 beta 6

meta title = "Locus logo"
meta note = "An exact figure, its defining path, and the point selected by their relations"

style textbook

class orbit { accent: #4F46E5, weight: 3.5 }
class relation { accent: #818CF8, fill: #EEF2FF, weight: 2.25, join: round }
class node { accent: #14B8A6, fill: #14B8A6, weight: 1 }
class solution { accent: #4F46E5, fill: #4F46E5, weight: 1 }
class wordmark { accent: #4F46E5 }

// The figure: an exact locus with three related points and their shared center.
point O() { mark: none }
num radius  = 1
circle path(O, radius) [orbit]

point A                   = on_circle(path, 90deg) { mark: none }
point B                   = on_circle(path, 210deg) { mark: none }
point C                   = on_circle(path, 330deg) { mark: none }
polygon relation_triangle(A, B, C) [relation]
circle node_a(A, 0.06) [node]
circle node_b(B, 0.06) [node]
circle node_c(C, 0.06) [node]
circle solution_point(O, 0.08) [solution]

// The wordmark is part of the scene, not text added after rendering.
text_block name("locus") [wordmark] { place: right }

assert dist(O, A) == radius and dist(O, B) == radius and dist(O, C) == radius
assert dist(A, B) == dist(B, C) and dist(B, C) == dist(C, A)
assert center(relation_triangle.centroid, O)
