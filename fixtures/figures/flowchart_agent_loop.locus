locus 2

meta {
  title "Agent workflow: never render until check passes"
  note  "v0.2 needed 95 lines of corner plumbing (findings F7/F8); v0.3 rects + relations"
}

style textbook

// ---- sizing constants --------------------------------------
num bw    = 3.4        // box width
num bh    = 1.1        // box height
num pitch = 2.3        // vertical center-to-center pitch
num side  = 5.6        // offset to the fix branch

// ---- spine nodes --------------------------------------------
point N1 = free ~(0, 0)  { mark: none }
rect  n1 = rect(N1, bw, bh)
label t1 = label(n1.center, "locus init")  { dir: center }

point N2 = free ~(0, -2.3) where { vertical(N1, N2), vdist(N2, N1) == pitch }  { mark: none }
rect  n2 = rect(N2, bw, bh)
label t2 = label(n2.center, "locus add < ops.locus")  { dir: center }

point N3 = free ~(0, -4.6) where { vertical(N2, N3), vdist(N3, N2) == pitch }  { mark: none }
rect  n3 = rect(N3, bw, bh)
label t3 = label(n3.center, "locus check")  { dir: center }

point   N4 = free ~(0, -6.9) where { vertical(N3, N4), vdist(N4, N3) == pitch }  { mark: none }
diamond n4 = diamond(N4, 3.2, 1.5)
label   t4 = label(n4.center, "exit 0?")  { dir: center }

point N5 = free ~(0, -9.2) where { vertical(N4, N5), vdist(N5, N4) == pitch }  { mark: none }
rect  n5 = rect(N5, bw, bh)   [highlight]
label t5 = label(n5.center, "locus render -o fig.svg")  { dir: center }

// ---- side node: fix ------------------------------------------
point NF = free ~(5.6, -6.9) where { horizontal(N4, NF), hdist(N4, NF) == side }  { mark: none }
rect  nf = rect(NF, bw, bh)
label tf = label(nf.center, "fix ops (update / edit)")  { dir: center }

// ---- edges ----------------------------------------------------
arrow a1 = arrow(n1.s, n2.n)  { head: -> }
arrow a2 = arrow(n2.s, n3.n)  { head: -> }
arrow a3 = arrow(n3.s, n4.n)  { head: -> }
arrow a4 = arrow(n4.s, n5.n)  { head: -> }
label ly = label(n4.s, "yes")  { dir: SW, gap: 0.15 }
arrow a5 = arrow(n4.e, nf.w)  { head: -> }
label ln = label(n4.e, "no")   { dir: NE, gap: 0.15 }
arrow a6 = arrow(nf.n, n2.e)  { head: ->, bend: 40deg }

// ---- layout invariants — the Locus payoff ---------------------
assert collinear(N1, N2, N3, N4, N5)               // spine
assert vdist(N2, N1) == vdist(N3, N2)              // equal pitch
assert n1.width == n3.width                        // equal widths
assert horizontal(N4, NF)                          // fix branch on the decision row
