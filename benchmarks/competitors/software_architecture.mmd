flowchart LR
    subgraph clients[Clients]
        direction TB
        web[Web client]
        mobile[Mobile app]
        partner[Partner API]
        cdn[CDN]
        monitor[Monitoring]
    end
    subgraph edge[Edge and control]
        direction TB
        gateway[API gateway]
        auth[Auth service]
        limit[Rate limiter]
        events[Event ingress]
        schedule[Scheduler]
    end
    subgraph application[Application]
        direction TB
        catalog[Catalog]
        orders[Orders]
        payments[Payments]
        inventory[Inventory]
        worker[Worker pool]
    end
    subgraph persistence[Persistence]
        direction TB
        products[(Product DB)]
        orderdb[(Order DB)]
        cache[(Cache)]
        queue[(Job queue)]
        audit[(Audit log)]
    end

    web --> gateway
    mobile --> gateway
    partner --> gateway
    cdn --> gateway
    gateway --> auth
    gateway --> limit
    gateway --> catalog
    gateway --> orders
    auth --> cache
    limit --> cache
    catalog --> products
    catalog --> cache
    orders --> orderdb
    orders --> payments
    orders --> inventory
    payments --> audit
    inventory --> products
    inventory --> cache
    events -.-> queue
    schedule -.-> queue
    queue -.-> worker
    worker -.-> orderdb
    worker -.-> audit
    worker -.-> events
    payments -.-> queue
    orders -.-> queue
    monitor -.-> gateway
    monitor -.-> worker
    partner -.-> events
    mobile -.-> auth
    web -.-> cdn
    schedule -.-> worker
