  "backends": ["locus", "svg"],
  "max_requests": 64,
  "timeout": 600,
  "versions": {"dsh": "0.1.5-rc.2", "pi": "0.84.4", "opencode": "1.18.35", "sharp": "0.35.4"},
  "node_minimum": "22.19.0",
  "rubric": {"geometry": 40, "completeness": 25, "readability": 20, "styling": 15},
  "decision_rule": "Lower tokens, all Locus SVGs exported, and no lower mean correctness, completeness or visual score"
}
