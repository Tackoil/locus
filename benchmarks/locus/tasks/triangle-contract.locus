// Independent geometry contract, appended only to a temporary source copy.
assert hdist(A, B) == 4 and vdist(A, B) == 0
assert hdist(A, C) == 0 and vdist(A, C) == 3
assert area(tri) == 6 and perimeter(tri) == 12
assert dist(B, C) == 5
assert coincident(H, foot(A, line(B, C)))
assert between(B, H, C)
assert coincident(altitude.start, A) and coincident(altitude.end, H)
assert length(altitude) == 2.4
assert perpendicular(altitude, seg(B, C))
assert on(A, circum) and on(B, circum) and on(C, circum)
assert coincident(circum.center, midpoint(B, C)) and radius(circum) == 2.5
assert radius(inc) == 1 and inside(inc.center, tri)
assert tangent(inc, line(A, B)) and tangent(inc, line(A, C)) and tangent(inc, line(B, C))
