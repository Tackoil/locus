locus 0 beta 6
point origin()
point tip()
rel hdist(origin, tip) == 10
rel vdist(origin, tip) == 0
arrow path(origin, tip)
label caption(path, "Below the connector") { near: middle }
point target()
rel hdist(origin, target) == 5
rel vdist(origin, target) == -2
rel center(caption, target)
assert center(caption, target)
