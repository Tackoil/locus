locus 2

meta {
  title "Delivery board: three teams, five states, cross-team blockers"
  note "Thirty-seven cards occupy fifteen cells; containment, WIP, stacking, and cross-lane dependencies are checked."
}

style textbook

class lane { accent: gray, fill: tint }
class pending { accent: blue, fill: tint }
class active { accent: orange, fill: tint }
class complete { accent: green, fill: tint }
class blocked { accent: red, fill: tint }
point O = free ~(0, 0) { mark: none }
num card_width = 4.6
num card_height = 1.25
num card_pitch = 1.65
label team0 = label(offset(O, -3, 0), "Platform") { dir: W }
rect lane0_0 = rect(offset(O, 0, 0), 5.4, 6.6) [lane]
label title0_0 = label(offset(lane0_0.n, 0, -0.45), "Backlog (2)") { dir: center }
rect card0_0_0 = rect(offset(lane0_0.n, 0, -1.6 - 0 * card_pitch), card_width, card_height) [pending]
label text_card0_0_0 = label(card0_0_0.center, "P-00: Search\nScope") { dir: center }
assert inside(card0_0_0.nw, lane0_0) and inside(card0_0_0.ne, lane0_0) and inside(card0_0_0.sw, lane0_0) and inside(card0_0_0.se, lane0_0)
rect card0_0_1 = rect(offset(lane0_0.n, 0, -1.6 - 1 * card_pitch), card_width, card_height) [pending]
label text_card0_0_1 = label(card0_0_1.center, "P-01: Export\nScope") { dir: center }
assert inside(card0_0_1.nw, lane0_0) and inside(card0_0_1.ne, lane0_0) and inside(card0_0_1.sw, lane0_0) and inside(card0_0_1.se, lane0_0)
assert vdist(card0_0_1.n, card0_0_0.s) == 0.4
