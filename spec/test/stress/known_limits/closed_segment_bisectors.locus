locus 0 beta 5

meta title = "Known limit: three simultaneous closed-segment bisectors stall"
meta note = "Expected E403 in the current solver. Supporting lines converge; the same between assertions enforce the segment domains."

point A = point()
point B = point() where { hdist(A, B) == -3, vdist(A, B) == -4.5 }
point C = point() where { hdist(A, C) == 4, vdist(A, C) == -4.5 }
line bis_a = angle_bisector(B, A, C)
line bis_b = angle_bisector(A, B, C)
line bis_c = angle_bisector(A, C, B)
point D = point() where { on(D, bis_a), on(D, seg(B, C)) }
point E = point() where { on(E, bis_b), on(E, seg(A, C)) }
point F = point() where { on(F, bis_c), on(F, seg(A, B)) }
assert between(B, D, C)
assert between(A, E, C)
assert between(A, F, B)
