locus 3

meta {
  title "AEC3 adaptive FIR filters aligned along time"
  note  "Each filter reads a different, overlapping region of the same render history. Scale: 1 unit = 32 ms."
}

style textbook

// exact color families and stroke treatments from the source image
class filterbox { accent: #2563EB, fill: #DBEAFE, weight: 1.25, join: round }
class overlap   { accent: #0F766E, fill: #CCFBF1, weight: 0.75, opacity: 0.88 }
class coeff     { accent: #2563EB, weight: 1 }
class offsetln  { stroke: dash(6, 3), accent: #2563EB, weight: 1, cap: round }
class peak      { accent: #EA580C, weight: 2, cap: round }
class peakln    { stroke: dash(6, 3), accent: #EA580C, weight: 1.25, cap: round }

// ---- scale constants ----------------------------------------
num fw    = 4          // filter span: 128 ms
num ov    = 1          // overlap: 32 ms
num bh    = 1.2        // filter box height
num pitch = 1.8        // row pitch (center to center)

// ---- render history axis: x[t] ------------------------------
point A0   = point()                                                        { mark: cross }
point A512 = point() where { horizontal(A0, A512), hdist(A0, A512) == 16 } { mark: cross }

arrow axis = arrow(A0, offset(A512, 0.6, 0))  { head: -> }
label lax  = label(A0, "render history x[t]")  { dir: W, gap: 0.4 }

// interior tick points — exact positions along the axis
point t96  = lerp(A0, A512,  96/512)  { mark: cross }
point t128 = lerp(A0, A512, 128/512)  { mark: cross }
point t192 = lerp(A0, A512, 192/512)  { mark: cross }
point t224 = lerp(A0, A512, 224/512)  { mark: cross }
point t288 = lerp(A0, A512, 288/512)  { mark: cross }
point t320 = lerp(A0, A512, 320/512)  { mark: cross }
point t384 = lerp(A0, A512, 384/512)  { mark: cross }
point t416 = lerp(A0, A512, 416/512)  { mark: cross }

label lt0   = label(A0,   "0 ms")    { dir: S, gap: 0.3 }
label lt96  = label(t96,  "96")      { dir: S, gap: 0.3 }
label lt128 = label(t128, "128")     { dir: S, gap: 0.3 }
label lt192 = label(t192, "192")     { dir: S, gap: 0.3 }
label lt224 = label(t224, "224")     { dir: S, gap: 0.3 }
label lt288 = label(t288, "288")     { dir: S, gap: 0.3 }
label lt320 = label(t320, "320")     { dir: S, gap: 0.3 }
label lt384 = label(t384, "384")     { dir: S, gap: 0.3 }
label lt416 = label(t416, "416")     { dir: S, gap: 0.3 }
label lt512 = label(A512, "512 ms")  { dir: S, gap: 0.3 }

// ---- five staggered filters ----------------------------------
// Each west edge sits exactly above its start tick; rows step down evenly.
rect f0 = rect(fw, bh) where { hdist(A0,   f0.center) == fw/2, vdist(A0, f0.center) == 8.8  }   [filterbox]
point F0c = f0.center { mark: none }
label n0  = label(offset(f0.n, 0, -0.28), "Filter 0")  { dir: center }
label r0  = label(offset(f0.w, 0.9, -0.25), "0–128 ms")  { dir: center }

rect f1 = rect(fw, bh) where { hdist(t96,  f1.center) == fw/2, vdist(f1.center, F0c) == pitch }   [filterbox]
point F1c = f1.center { mark: none }
label n1  = label(offset(f1.n, 0, -0.28), "Filter 1")  { dir: center }
label r1  = label(offset(f1.w, 0.9, -0.25), "96–224 ms")  { dir: center }

rect f2 = rect(fw, bh) where { hdist(t192, f2.center) == fw/2, vdist(f2.center, F1c) == pitch }   [filterbox]
point F2c = f2.center { mark: none }
label n2  = label(offset(f2.n, 0, -0.28), "Filter 2")  { dir: center }
label r2  = label(offset(f2.w, 0.9, -0.25), "192–320 ms")  { dir: center }

rect f3 = rect(fw, bh) where { hdist(t288, f3.center) == fw/2, vdist(f3.center, F2c) == pitch }   [filterbox]
point F3c = f3.center { mark: none }
label n3  = label(offset(f3.n, 0, -0.28), "Filter 3")  { dir: center }
label r3  = label(offset(f3.w, 0.9, -0.25), "288–416 ms")  { dir: center }

rect f4 = rect(fw, bh) where { hdist(t384, f4.center) == fw/2, vdist(f4.center, F3c) == pitch }   [filterbox]
point F4c = f4.center { mark: none }
label n4  = label(offset(f4.n, 0, -0.28), "Filter 4")  { dir: center }
label r4  = label(offset(f4.w, 0.9, -0.25), "384–512 ms")  { dir: center }

// ---- 32 ms overlap strips (shared regions with the neighbours)
rect s0e = rect(offset(f0.e, -ov/2, 0), ov, bh)   [overlap]
rect s1w = rect(offset(f1.w,  ov/2, 0), ov, bh)   [overlap]
rect s1e = rect(offset(f1.e, -ov/2, 0), ov, bh)   [overlap]
rect s2w = rect(offset(f2.w,  ov/2, 0), ov, bh)   [overlap]
rect s2e = rect(offset(f2.e, -ov/2, 0), ov, bh)   [overlap]
rect s3w = rect(offset(f3.w,  ov/2, 0), ov, bh)   [overlap]
rect s3e = rect(offset(f3.e, -ov/2, 0), ov, bh)   [overlap]
rect s4w = rect(offset(f4.w,  ov/2, 0), ov, bh)   [overlap]

// ---- capture y[t] feed ---------------------------------------
point cap_top = offset(f0.w, -1.2, 0.6)  { mark: none }
point cap_bot = point() where { vertical(cap_top, cap_bot), horizontal(cap_bot, F4c) }  { mark: none }
segment cap = seg(cap_top, cap_bot)
label lcap = label(cap_top, "capture y[t]")  { dir: NW, gap: 0.2 }

arrow c0 = arrow(foot(F0c, cap), f0.w)  { head: -> }
arrow c1 = arrow(foot(F1c, cap), f1.w)  { head: -> }
arrow c2 = arrow(foot(F2c, cap), f2.w)  { head: -> }
arrow c3 = arrow(foot(F3c, cap), f3.w)  { head: -> }
arrow c4 = arrow(foot(F4c, cap), f4.w)  { head: -> }

// ---- filter 2 coefficient stems ------------------------------
point sb0 = offset(f2.sw, 0.35, 0.25)   { mark: none }
point sb1 = offset(f2.se, -0.35, 0.25)  { mark: none }
segment coef_base = seg(sb0, sb1)   [auxiliary]

point q1 = offset(lerp(sb0, sb1, 0.05), 0, 0.22)  [coeff]  { mark: dot }
segment st1 = seg(lerp(sb0, sb1, 0.05), q1)  [coeff]
point q2 = offset(lerp(sb0, sb1, 0.18), 0, 0.30)  [coeff]  { mark: dot }
segment st2 = seg(lerp(sb0, sb1, 0.18), q2)  [coeff]
point q3 = offset(lerp(sb0, sb1, 0.32), 0, 0.24)  [coeff]  { mark: dot }
segment st3 = seg(lerp(sb0, sb1, 0.32), q3)  [coeff]
point q4 = offset(lerp(sb0, sb1, 0.66), 0, 0.28)  [coeff]  { mark: dot }
segment st4 = seg(lerp(sb0, sb1, 0.66), q4)  [coeff]
point q5 = offset(lerp(sb0, sb1, 0.80), 0, 0.20)  [coeff]  { mark: dot }
segment st5 = seg(lerp(sb0, sb1, 0.80), q5)  [coeff]
point q6 = offset(lerp(sb0, sb1, 0.93), 0, 0.26)  [coeff]  { mark: dot }
segment st6 = seg(lerp(sb0, sb1, 0.93), q6)  [coeff]

// the winning coefficient: local peak k*
point kb    = lerp(sb0, sb1, 0.5)   { mark: none }
point kstar = offset(kb, 0, 0.45)   [peak]  { mark: dot }
segment stk = seg(kb, kstar)        [peak]
label lk = label(kstar, "local peak k*")  [peak]  { dir: E, gap: 2.2 }
arrow ak = arrow(lk.center, kstar)  [peak]  { head: -> }

// ---- delay decomposition (color-coded drop lines via classes) --
segment o2drop = seg(f2.sw, t192)   [offsetln]
label lo2 = label(o2drop.midpoint, "filter offset $O_2$")  [offsetln]  { dir: W, gap: 0.25 }

point kdrop = foot(kb, seg(A0, A512))  { mark: none }
segment kline = seg(kb, kdrop)      [peakln]

// ---- total delay box below the axis --------------------------
rect td = rect(9.5, 1) where { vertical(td.center, kdrop), vdist(td.center, A0) == 1.9 }
point TDc = td.center { mark: none }
label ltd = label(td.center, "total delay = filter offset $O_2$ + local peak $k^*$")  { dir: center }

// ---- legends ---------------------------------------------------
rect lg = rect(0.6, 0.45) where { horizontal(lg.center, F0c), vertical(lg.center, A512) }   [overlap]
point LGc = lg.center { mark: none }
label llg = label(lg.e, "32 ms overlap")  { dir: E, gap: 0.2 }

label lg1 = label(offset(TDc, -3, -1.3), "coefficient position → delay")   [coeff]  { dir: center }
label lg2 = label(offset(TDc,  4, -1.3), "coefficient height → echo gain") [coeff]  { dir: center }

text_block sub = text_block("Each filter reads a different, overlapping region of the same render history")  { place: above }
text_block eq  = text_block($\hat{y}[t] = \textstyle\sum_n h_n[k]\, x[t - (O_n + k)]$)  { place: below }

// ---- alignment invariants — the Locus payoff -------------------
assert vertical(f0.w, A0) and vertical(f2.w, t192)        // boxes sit exactly on their time positions
assert hdist(f2.w, f2.e) == fw                            // every filter spans 128 ms
assert hdist(f1.w, f0.e) == ov and hdist(f2.w, f1.e) == ov  // neighbours overlap by exactly 32 ms
assert collinear(F0c, F1c, F2c, F3c, F4c)                 // even diagonal stagger
assert vdist(F1c, F0c) == vdist(F2c, F1c)                 // equal row pitch
assert on(kdrop, seg(A0, A512))
assert between(t224, kdrop, t288)                         // the peak lands between 224 and 288 ms
assert hdist(A0, kdrop) == hdist(A0, t192) + hdist(t192, kdrop)   // total delay = O2 + k*

// ---- stress construction network ----
// Four additional coefficient banks feed per-filter delay estimates and a comparison strip.
point coeff0_0 = offset(lerp(f0.sw, f0.se, 0.03125), 0, 0.120) { mark: none }
segment stem0_0 = seg(foot(coeff0_0, seg(f0.sw, f0.se)), coeff0_0) [coeff]
assert inside(coeff0_0, f0)
assert length(stem0_0) == 0.120
point coeff0_1 = offset(lerp(f0.sw, f0.se, 0.09375), 0, 0.295) { mark: none }
segment stem0_1 = seg(foot(coeff0_1, seg(f0.sw, f0.se)), coeff0_1) [coeff]
assert inside(coeff0_1, f0)
assert length(stem0_1) == 0.295
point coeff0_2 = offset(lerp(f0.sw, f0.se, 0.15625), 0, 0.195) { mark: none }
segment stem0_2 = seg(foot(coeff0_2, seg(f0.sw, f0.se)), coeff0_2) [coeff]
assert inside(coeff0_2, f0)
assert length(stem0_2) == 0.195
point coeff0_3 = offset(lerp(f0.sw, f0.se, 0.21875), 0, 0.370) { mark: none }
segment stem0_3 = seg(foot(coeff0_3, seg(f0.sw, f0.se)), coeff0_3) [coeff]
assert inside(coeff0_3, f0)
assert length(stem0_3) == 0.370
point coeff0_4 = offset(lerp(f0.sw, f0.se, 0.28125), 0, 0.270) { mark: none }
segment stem0_4 = seg(foot(coeff0_4, seg(f0.sw, f0.se)), coeff0_4) [coeff]
assert inside(coeff0_4, f0)
assert length(stem0_4) == 0.270
point coeff0_5 = offset(lerp(f0.sw, f0.se, 0.34375), 0, 0.170) { mark: none }
segment stem0_5 = seg(foot(coeff0_5, seg(f0.sw, f0.se)), coeff0_5) [coeff]
assert inside(coeff0_5, f0)
assert length(stem0_5) == 0.170
point coeff0_6 = offset(lerp(f0.sw, f0.se, 0.40625), 0, 0.345) { mark: none }
segment stem0_6 = seg(foot(coeff0_6, seg(f0.sw, f0.se)), coeff0_6) [coeff]
assert inside(coeff0_6, f0)
assert length(stem0_6) == 0.345
point coeff0_7 = offset(lerp(f0.sw, f0.se, 0.46875), 0, 0.245) { mark: none }
segment stem0_7 = seg(foot(coeff0_7, seg(f0.sw, f0.se)), coeff0_7) [coeff]
assert inside(coeff0_7, f0)
assert length(stem0_7) == 0.245
point coeff0_8 = offset(lerp(f0.sw, f0.se, 0.53125), 0, 0.145) { mark: none }
segment stem0_8 = seg(foot(coeff0_8, seg(f0.sw, f0.se)), coeff0_8) [coeff]
assert inside(coeff0_8, f0)
assert length(stem0_8) == 0.145
point coeff0_9 = offset(lerp(f0.sw, f0.se, 0.59375), 0, 0.320) { mark: none }
segment stem0_9 = seg(foot(coeff0_9, seg(f0.sw, f0.se)), coeff0_9) [coeff]
assert inside(coeff0_9, f0)
assert length(stem0_9) == 0.320
point coeff0_10 = offset(lerp(f0.sw, f0.se, 0.65625), 0, 0.220) { mark: none }
segment stem0_10 = seg(foot(coeff0_10, seg(f0.sw, f0.se)), coeff0_10) [coeff]
assert inside(coeff0_10, f0)
assert length(stem0_10) == 0.220
point coeff0_11 = offset(lerp(f0.sw, f0.se, 0.71875), 0, 0.120) { mark: none }
segment stem0_11 = seg(foot(coeff0_11, seg(f0.sw, f0.se)), coeff0_11) [coeff]
assert inside(coeff0_11, f0)
assert length(stem0_11) == 0.120
point coeff0_12 = offset(lerp(f0.sw, f0.se, 0.78125), 0, 0.295) { mark: none }
segment stem0_12 = seg(foot(coeff0_12, seg(f0.sw, f0.se)), coeff0_12) [coeff]
assert inside(coeff0_12, f0)
assert length(stem0_12) == 0.295
point coeff0_13 = offset(lerp(f0.sw, f0.se, 0.84375), 0, 0.195) { mark: none }
segment stem0_13 = seg(foot(coeff0_13, seg(f0.sw, f0.se)), coeff0_13) [coeff]
assert inside(coeff0_13, f0)
assert length(stem0_13) == 0.195
point coeff0_14 = offset(lerp(f0.sw, f0.se, 0.90625), 0, 0.370) { mark: none }
segment stem0_14 = seg(foot(coeff0_14, seg(f0.sw, f0.se)), coeff0_14) [coeff]
assert inside(coeff0_14, f0)
assert length(stem0_14) == 0.370
point coeff0_15 = offset(lerp(f0.sw, f0.se, 0.96875), 0, 0.270) { mark: none }
segment stem0_15 = seg(foot(coeff0_15, seg(f0.sw, f0.se)), coeff0_15) [coeff]
assert inside(coeff0_15, f0)
assert length(stem0_15) == 0.270
point delay0 = foot(coeff0_5, seg(A0, A512)) { mark: none }
segment delayline0 = seg(coeff0_5, delay0) [peakln]
num delay_value0 = hdist(A0, delay0)
assert delay_value0 == hdist(A0, f0.w) + hdist(f0.w, coeff0_5)
point coeff1_0 = offset(lerp(f1.sw, f1.se, 0.03125), 0, 0.195) { mark: none }
segment stem1_0 = seg(foot(coeff1_0, seg(f1.sw, f1.se)), coeff1_0) [coeff]
assert inside(coeff1_0, f1)
assert length(stem1_0) == 0.195
point coeff1_1 = offset(lerp(f1.sw, f1.se, 0.09375), 0, 0.370) { mark: none }
segment stem1_1 = seg(foot(coeff1_1, seg(f1.sw, f1.se)), coeff1_1) [coeff]
assert inside(coeff1_1, f1)
assert length(stem1_1) == 0.370
point coeff1_2 = offset(lerp(f1.sw, f1.se, 0.15625), 0, 0.270) { mark: none }
segment stem1_2 = seg(foot(coeff1_2, seg(f1.sw, f1.se)), coeff1_2) [coeff]
assert inside(coeff1_2, f1)
assert length(stem1_2) == 0.270
point coeff1_3 = offset(lerp(f1.sw, f1.se, 0.21875), 0, 0.170) { mark: none }
segment stem1_3 = seg(foot(coeff1_3, seg(f1.sw, f1.se)), coeff1_3) [coeff]
assert inside(coeff1_3, f1)
assert length(stem1_3) == 0.170
point coeff1_4 = offset(lerp(f1.sw, f1.se, 0.28125), 0, 0.345) { mark: none }
segment stem1_4 = seg(foot(coeff1_4, seg(f1.sw, f1.se)), coeff1_4) [coeff]
assert inside(coeff1_4, f1)
assert length(stem1_4) == 0.345
point coeff1_5 = offset(lerp(f1.sw, f1.se, 0.34375), 0, 0.245) { mark: none }
segment stem1_5 = seg(foot(coeff1_5, seg(f1.sw, f1.se)), coeff1_5) [coeff]
assert inside(coeff1_5, f1)
assert length(stem1_5) == 0.245
point coeff1_6 = offset(lerp(f1.sw, f1.se, 0.40625), 0, 0.145) { mark: none }
segment stem1_6 = seg(foot(coeff1_6, seg(f1.sw, f1.se)), coeff1_6) [coeff]
assert inside(coeff1_6, f1)
assert length(stem1_6) == 0.145
point coeff1_7 = offset(lerp(f1.sw, f1.se, 0.46875), 0, 0.320) { mark: none }
segment stem1_7 = seg(foot(coeff1_7, seg(f1.sw, f1.se)), coeff1_7) [coeff]
assert inside(coeff1_7, f1)
assert length(stem1_7) == 0.320
point coeff1_8 = offset(lerp(f1.sw, f1.se, 0.53125), 0, 0.220) { mark: none }
segment stem1_8 = seg(foot(coeff1_8, seg(f1.sw, f1.se)), coeff1_8) [coeff]
assert inside(coeff1_8, f1)
assert length(stem1_8) == 0.220
point coeff1_9 = offset(lerp(f1.sw, f1.se, 0.59375), 0, 0.120) { mark: none }
segment stem1_9 = seg(foot(coeff1_9, seg(f1.sw, f1.se)), coeff1_9) [coeff]
assert inside(coeff1_9, f1)
assert length(stem1_9) == 0.120
point coeff1_10 = offset(lerp(f1.sw, f1.se, 0.65625), 0, 0.295) { mark: none }
segment stem1_10 = seg(foot(coeff1_10, seg(f1.sw, f1.se)), coeff1_10) [coeff]
assert inside(coeff1_10, f1)
assert length(stem1_10) == 0.295
point coeff1_11 = offset(lerp(f1.sw, f1.se, 0.71875), 0, 0.195) { mark: none }
segment stem1_11 = seg(foot(coeff1_11, seg(f1.sw, f1.se)), coeff1_11) [coeff]
assert inside(coeff1_11, f1)
assert length(stem1_11) == 0.195
point coeff1_12 = offset(lerp(f1.sw, f1.se, 0.78125), 0, 0.370) { mark: none }
segment stem1_12 = seg(foot(coeff1_12, seg(f1.sw, f1.se)), coeff1_12) [coeff]
assert inside(coeff1_12, f1)
assert length(stem1_12) == 0.370
point coeff1_13 = offset(lerp(f1.sw, f1.se, 0.84375), 0, 0.270) { mark: none }
segment stem1_13 = seg(foot(coeff1_13, seg(f1.sw, f1.se)), coeff1_13) [coeff]
assert inside(coeff1_13, f1)
assert length(stem1_13) == 0.270
point coeff1_14 = offset(lerp(f1.sw, f1.se, 0.90625), 0, 0.170) { mark: none }
segment stem1_14 = seg(foot(coeff1_14, seg(f1.sw, f1.se)), coeff1_14) [coeff]
assert inside(coeff1_14, f1)
assert length(stem1_14) == 0.170
point coeff1_15 = offset(lerp(f1.sw, f1.se, 0.96875), 0, 0.345) { mark: none }
segment stem1_15 = seg(foot(coeff1_15, seg(f1.sw, f1.se)), coeff1_15) [coeff]
assert inside(coeff1_15, f1)
assert length(stem1_15) == 0.345
point delay1 = foot(coeff1_8, seg(A0, A512)) { mark: none }
segment delayline1 = seg(coeff1_8, delay1) [peakln]
num delay_value1 = hdist(A0, delay1)
assert delay_value1 == hdist(A0, f1.w) + hdist(f1.w, coeff1_8)
point coeff3_0 = offset(lerp(f3.sw, f3.se, 0.03125), 0, 0.345) { mark: none }
segment stem3_0 = seg(foot(coeff3_0, seg(f3.sw, f3.se)), coeff3_0) [coeff]
assert inside(coeff3_0, f3)
assert length(stem3_0) == 0.345
point coeff3_1 = offset(lerp(f3.sw, f3.se, 0.09375), 0, 0.245) { mark: none }
segment stem3_1 = seg(foot(coeff3_1, seg(f3.sw, f3.se)), coeff3_1) [coeff]
assert inside(coeff3_1, f3)
assert length(stem3_1) == 0.245
point coeff3_2 = offset(lerp(f3.sw, f3.se, 0.15625), 0, 0.145) { mark: none }
segment stem3_2 = seg(foot(coeff3_2, seg(f3.sw, f3.se)), coeff3_2) [coeff]
assert inside(coeff3_2, f3)
assert length(stem3_2) == 0.145
point coeff3_3 = offset(lerp(f3.sw, f3.se, 0.21875), 0, 0.320) { mark: none }
segment stem3_3 = seg(foot(coeff3_3, seg(f3.sw, f3.se)), coeff3_3) [coeff]
assert inside(coeff3_3, f3)
assert length(stem3_3) == 0.320
point coeff3_4 = offset(lerp(f3.sw, f3.se, 0.28125), 0, 0.220) { mark: none }
segment stem3_4 = seg(foot(coeff3_4, seg(f3.sw, f3.se)), coeff3_4) [coeff]
assert inside(coeff3_4, f3)
assert length(stem3_4) == 0.220
point coeff3_5 = offset(lerp(f3.sw, f3.se, 0.34375), 0, 0.120) { mark: none }
segment stem3_5 = seg(foot(coeff3_5, seg(f3.sw, f3.se)), coeff3_5) [coeff]
assert inside(coeff3_5, f3)
assert length(stem3_5) == 0.120
point coeff3_6 = offset(lerp(f3.sw, f3.se, 0.40625), 0, 0.295) { mark: none }
segment stem3_6 = seg(foot(coeff3_6, seg(f3.sw, f3.se)), coeff3_6) [coeff]
assert inside(coeff3_6, f3)
assert length(stem3_6) == 0.295
point coeff3_7 = offset(lerp(f3.sw, f3.se, 0.46875), 0, 0.195) { mark: none }
segment stem3_7 = seg(foot(coeff3_7, seg(f3.sw, f3.se)), coeff3_7) [coeff]
assert inside(coeff3_7, f3)
assert length(stem3_7) == 0.195
point coeff3_8 = offset(lerp(f3.sw, f3.se, 0.53125), 0, 0.370) { mark: none }
segment stem3_8 = seg(foot(coeff3_8, seg(f3.sw, f3.se)), coeff3_8) [coeff]
assert inside(coeff3_8, f3)
assert length(stem3_8) == 0.370
