locus 0 beta 5

meta title = "Release schedule: twenty tasks, parallel teams, joins, and progress"
meta note = "Duration variables start away from their targets; max dependencies propagate through five phases to the release gate."

style textbook

class planned { accent: gray, stroke: dashed }
class actual { accent: blue, fill: tint }
class progress { accent: teal, fill: tint }
class dependency { accent: purple, stroke: dashed }
point O = point() { mark: none }
num day = 0.75
num duration0_0 = free 2.2
rel duration0_0 == 2
num start0_0 = 0
num finish0_0 = start0_0 + duration0_0
rect baseline0_0 = rect(offset(O, 1.00 * day, -1.50), 2 * day, 0.8) [planned]
rect task0_0 = rect(offset(O, (start0_0 + duration0_0 / 2) * day, -1.50), duration0_0 * day, 0.65) [actual]
rect done0_0 = rect(offset(task0_0.w, task0_0.width * 1 / 2, 0), task0_0.width * 1, 0.3) [progress]
label task_label0_0 = label(task0_0.w, "T1: Design") { dir: W }
assert task0_0.width / day == 2
assert hdist(O, task0_0.w) / day == 0
assert done0_0.width <= task0_0.width
assert coincident(done0_0.w, task0_0.w)
