point f1_3_0tb = offset(f1_3_0tt, 0, -flow1_3_0 * scale) { mark: none }
polygon f1_3_0band = polygon(f1_3_0sb, f1_3_0st, f1_3_0tt, f1_3_0tb) [flow0]
assert vdist(f1_3_0sb, f1_3_0st) / scale == 4
assert vdist(f1_3_0sb, f1_3_0st) == vdist(f1_3_0tb, f1_3_0tt)
assert area(f1_3_0band) == 4 * scale * hdist(f1_3_0st, f1_3_0tt)
