locus 2

meta {
  title "Conserved flow network: three sources, four processes, four outputs"
  note "Twenty-eight weighted polygon bands split and merge across two stages. Thickness is measured vertically at ports."
}

style textbook

class node { accent: gray, fill: tint }
point O = free ~(0, 0) { mark: none }
num scale = 0.12
class flow0 { accent: #14B8A6, fill: #14B8A6, opacity: 0.55 }
class flow1 { accent: #3B82F6, fill: #3B82F6, opacity: 0.55 }
class flow2 { accent: #F59E0B, fill: #F59E0B, opacity: 0.55 }
class flow3 { accent: #A855F7, fill: #A855F7, opacity: 0.55 }
point center0_0 = offset(O, 0, 8 - (0 + 40/2) * scale - 0 * 1.6) { mark: none }
point center0_1 = offset(O, 0, 8 - (40 + 35/2) * scale - 1 * 1.6) { mark: none }
point center0_2 = offset(O, 0, 8 - (75 + 25/2) * scale - 2 * 1.6) { mark: none }
point center1_0 = offset(O, 10, 8 - (0 + 32/2) * scale - 0 * 1.6) { mark: none }
point center1_1 = offset(O, 10, 8 - (32 + 26/2) * scale - 1 * 1.6) { mark: none }
point center1_2 = offset(O, 10, 8 - (58 + 26/2) * scale - 2 * 1.6) { mark: none }
point center1_3 = offset(O, 10, 8 - (84 + 16/2) * scale - 3 * 1.6) { mark: none }
point center2_0 = offset(O, 20, 8 - (0 + 40/2) * scale - 0 * 1.6) { mark: none }
point center2_1 = offset(O, 20, 8 - (40 + 28/2) * scale - 1 * 1.6) { mark: none }
point center2_2 = offset(O, 20, 8 - (68 + 22/2) * scale - 2 * 1.6) { mark: none }
point center2_3 = offset(O, 20, 8 - (90 + 10/2) * scale - 3 * 1.6) { mark: none }
num flow0_0_0 = 18
point f0_0_0st = offset(center0_0, 0.3, 20.0 * scale) { mark: none }
point f0_0_0sb = offset(f0_0_0st, 0, -flow0_0_0 * scale) { mark: none }
point f0_0_0tt = offset(center1_0, -0.3, 16.0 * scale) { mark: none }
point f0_0_0tb = offset(f0_0_0tt, 0, -flow0_0_0 * scale) { mark: none }
polygon f0_0_0band = polygon(f0_0_0sb, f0_0_0st, f0_0_0tt, f0_0_0tb) [flow0]
assert vdist(f0_0_0sb, f0_0_0st) / scale == 18
assert vdist(f0_0_0sb, f0_0_0st) == vdist(f0_0_0tb, f0_0_0tt)
assert area(f0_0_0band) == 18 * scale * hdist(f0_0_0st, f0_0_0tt)
