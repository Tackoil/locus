rect node0_0 = rect(center0_0, 0.6, 40 * scale) [node]
label label0_0 = label(node0_0.n, "Source 1: 40") { dir: N }
rect node0_1 = rect(center0_1, 0.6, 35 * scale) [node]
label label0_1 = label(node0_1.n, "Source 2: 35") { dir: N }
rect node0_2 = rect(center0_2, 0.6, 25 * scale) [node]
label label0_2 = label(node0_2.n, "Source 3: 25") { dir: N }
rect node1_0 = rect(center1_0, 0.6, 32 * scale) [node]
label label1_0 = label(node1_0.n, "Process 1: 32") { dir: N }
rect node1_1 = rect(center1_1, 0.6, 26 * scale) [node]
label label1_1 = label(node1_1.n, "Process 2: 26") { dir: N }
rect node1_2 = rect(center1_2, 0.6, 26 * scale) [node]
label label1_2 = label(node1_2.n, "Process 3: 26") { dir: N }
rect node1_3 = rect(center1_3, 0.6, 16 * scale) [node]
label label1_3 = label(node1_3.n, "Process 4: 16") { dir: N }
rect node2_0 = rect(center2_0, 0.6, 40 * scale) [node]
label label2_0 = label(node2_0.n, "Output 1: 40") { dir: N }
rect node2_1 = rect(center2_1, 0.6, 28 * scale) [node]
label label2_1 = label(node2_1.n, "Output 2: 28") { dir: N }
rect node2_2 = rect(center2_2, 0.6, 22 * scale) [node]
label label2_2 = label(node2_2.n, "Output 3: 22") { dir: N }
