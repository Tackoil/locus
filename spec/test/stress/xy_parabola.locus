num trapezoidal_area = area(trap0) + area(trap1) + area(trap2) + area(trap3) + area(trap4) + area(trap5) + area(trap6) + area(trap7) + area(trap8) + area(trap9) + area(trap10) + area(trap11) + area(trap12) + area(trap13) + area(trap14) + area(trap15) + area(trap16) + area(trap17) + area(trap18) + area(trap19) + area(trap20) + area(trap21) + area(trap22) + area(trap23) + area(trap24) + area(trap25) + area(trap26) + area(trap27) + area(trap28) + area(trap29) + area(trap30) + area(trap31)
assert trapezoidal_area / (unit * unit) == 9.017578125
assert trapezoidal_area > 9 * unit * unit
