line linear_function = line(offset(O, -3 * unit, -2 * unit), offset(O, 3 * unit, 4 * unit)) [auxiliary]
// Positive distances from the symmetry axis select the two root branches.
num left_span = free ~1.8
num right_span = free ~1.6
point cross_left = offset(O, (1 - sqrt(left_span * left_span)) * unit, (2 - sqrt(left_span * left_span)) * unit)
point cross_right = offset(O, (1 + sqrt(right_span * right_span)) * unit, (2 + sqrt(right_span * right_span)) * unit)
rel vdist(O, cross_left) / unit == (hdist(O, cross_left) / unit) * (hdist(O, cross_left) / unit) / 2
assert vdist(O, cross_left) / unit == hdist(O, cross_left) / unit + 1
rel vdist(O, cross_right) / unit == (hdist(O, cross_right) / unit) * (hdist(O, cross_right) / unit) / 2
assert vdist(O, cross_right) / unit == hdist(O, cross_right) / unit + 1
assert hdist(O, cross_left) / unit == 1 - sqrt(3)
assert hdist(O, cross_right) / unit == 1 + sqrt(3)
assert hdist(cross_left, cross_right) / unit == 2 * sqrt(3)
polygon trap0 = polygon(offset(O, -3.0 * unit, 0), dense0, dense4, offset(O, -2.8125 * unit, 0)) [construction]
