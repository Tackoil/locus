locus 3

meta {
  title "X-Y stress plot: parabola, linear intersections, and composite area"
  note "129 samples and 32 integration cells. Intersections solve the analytic equations; segments approximate the curve. One scene unit represents one axis unit."
}

style textbook
class curve { accent: blue, weight: 2, cap: round, join: round }

point O = point() { mark: none }
num unit = 1
arrow x_axis = arrow(offset(O, -3.5 * unit, 0), offset(O, 3.5 * unit, 0))
arrow y_axis = arrow(offset(O, 0, -0.5 * unit), offset(O, 0, 5 * unit))
label lx = label(offset(O, 3.5 * unit, 0), "x") { dir: E }
label ly = label(offset(O, 0, 5 * unit), "y") { dir: N }
label zero = label(O, "0") { dir: SW }

// Normalize coordinates before squaring: a plotted y coordinate is a length, not an area.
num x3 = 3
num x2 = 2
num x1 = 1
num xhalf = 0.5
point P3 = offset(O, x3 * unit, x3 * x3 * unit / 2) { mark: none }
point P2 = offset(O, x2 * unit, x2 * x2 * unit / 2) { mark: none }
point P1 = offset(O, x1 * unit, x1 * x1 * unit / 2) { mark: none }
point Phalf = offset(O, xhalf * unit, xhalf * xhalf * unit / 2) { mark: none }
line symmetry = line(O, offset(O, 0, unit)) [construction]
point N3 = reflect(P3, symmetry) { mark: none }
point N2 = reflect(P2, symmetry) { mark: none }
point N1 = reflect(P1, symmetry) { mark: none }
point Nhalf = reflect(Phalf, symmetry) { mark: none }
segment guide = seg(P2, offset(O, 2 * unit, 0)) [auxiliary]
label sample = label(P2, "(2, 2)") { dir: E }
text_block caption = text_block("y = x^2 / 2 (sampled); domain: -3 to 3") { place: below }

assert perpendicular(seg(O, offset(O, unit, 0)), symmetry)
assert vdist(O, P3) / unit == 4.5
assert vdist(O, P2) / unit == 2
assert vdist(O, P1) / unit == 0.5
assert vdist(O, Phalf) / unit == 0.125
assert hdist(N3, O) == hdist(O, P3)
assert horizontal(N2, P2) and horizontal(N1, P1)
assert vdist(O, N3) / unit == (hdist(O, N3) / unit) * (hdist(O, N3) / unit) / 2
assert vdist(O, Phalf) < vdist(O, P1) and vdist(O, P1) < vdist(O, P2)

// ---- stress construction network ----
// 129 samples, a second function, nonlinear intersections, and a composite-area check.
point dense0 = offset(O, -3.00000000 * unit, (-3.00000000) * (-3.00000000) * unit / 2) { mark: none }
assert vdist(O, dense0) / unit == 4.500000000000
point dense1 = offset(O, -2.95312500 * unit, (-2.95312500) * (-2.95312500) * unit / 2) { mark: none }
segment dense_seg1 = seg(dense0, dense1) [curve]
assert vdist(O, dense1) / unit == 4.360473632812
point dense2 = offset(O, -2.90625000 * unit, (-2.90625000) * (-2.90625000) * unit / 2) { mark: none }
segment dense_seg2 = seg(dense1, dense2) [curve]
