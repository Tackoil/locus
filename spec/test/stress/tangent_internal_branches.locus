point it2 = lerp(O, ic2, outer_radius / (outer_radius - ir2)) { mark: none }
line iu2 = tangent_line(E, inner2, 0) [construction]
line il2 = tangent_line(E, inner2, 1) [construction]
point ifu2 = foot(ic2, iu2) { mark: none }
point ifl2 = foot(ic2, il2) { mark: none }
assert coincident(it2, rim2)
assert on(it2, inner2) and on(it2, outer)
assert perpendicular(seg(ic2, ifu2), iu2) and perpendicular(seg(ic2, ifl2), il2)
assert dist(E, ifu2) == dist(E, ifl2)
assert coincident(reflect(ifu2, line(ic2, E)), ifl2)
