locus 0 beta 4

meta {
  title "Internal circle contact and both tangents from an exterior point"
  note "Construct contact points directly; distance-only tangency residuals cannot guarantee angular accuracy."
}

style textbook

point O = point()
num outer_radius = 3
num inner_radius = 1
circle outer = circle(O, outer_radius)
circle inner = circle(inner_radius) where { horizontal(O, inner.center), hdist(O, inner.center) == outer_radius - inner_radius } [highlight]
point I = inner.center
// Internal tangency is ordered: the outer circle contains the inner circle.
rel internally_tangent(outer, inner)
point T = lerp(O, I, outer_radius / (outer_radius - inner_radius))
line contact = perpendicular(T, line(O, I)) [auxiliary]

point E = offset(O, 6, 0)
line upper = tangent_line(E, outer, 0) [auxiliary]
line lower = tangent_line(E, outer, 1) [auxiliary]
point U = foot(O, upper)
point L = foot(O, lower)
segment radius_upper = seg(O, U) [construction]
segment radius_lower = seg(O, L) [construction]
right_angle upper_mark = right_angle(U, O, E)
right_angle lower_mark = right_angle(L, O, E)

label lo = label(O, "O") { dir: W }
label li = label(I, "I") { dir: S }
label lt = label(T, "T") { dir: SE }
label le = label(E, "E") { dir: E }
label lu = label(U, "U (branch 0)") { dir: NE }
label ll = label(L, "L (branch 1)") { dir: SE }

assert dist(O, I) == outer_radius - inner_radius
assert between(O, I, T)
assert on(T, inner) and on(T, outer)
assert tangent(inner, contact) and tangent(outer, contact)
assert on(U, outer) and on(L, outer)
assert perpendicular(radius_upper, upper) and perpendicular(radius_lower, lower)
assert tangent(outer, upper) and tangent(outer, lower)
assert dist(E, U) == dist(E, L)
assert dist(E, U) * dist(E, U) == dist(E, O) * dist(E, O) - outer_radius * outer_radius
assert coincident(reflect(U, line(O, E)), L)
assert vdist(O, U) > 0 and vdist(O, L) < 0

// ---- stress construction network ----
// Eight internal contacts couple nonlinear circle distances to radial carriers.
num ir0 = 0.3000
point rim0 = on_circle(outer, 22.5deg) { mark: none }
line spoke0 = line(O, rim0) [construction]
num separation0 = free ~2.7250
num bearing0 = free ~23.0deg
point ic0 = rotate(offset(O, separation0, 0), O, bearing0) where { on(ic0, ray(O, rim0)) } { mark: none }
circle inner0 = circle(ic0, ir0) [auxiliary]
rel internally_tangent(outer, inner0)
point it0 = lerp(O, ic0, outer_radius / (outer_radius - ir0)) { mark: none }
line iu0 = tangent_line(E, inner0, 0) [construction]
line il0 = tangent_line(E, inner0, 1) [construction]
point ifu0 = foot(ic0, iu0) { mark: none }
point ifl0 = foot(ic0, il0) { mark: none }
assert coincident(it0, rim0)
assert on(it0, inner0) and on(it0, outer)
assert perpendicular(seg(ic0, ifu0), iu0) and perpendicular(seg(ic0, ifl0), il0)
assert dist(E, ifu0) == dist(E, ifl0)
assert coincident(reflect(ifu0, line(ic0, E)), ifl0)
num ir1 = 0.3350
point rim1 = on_circle(outer, 67.5deg) { mark: none }
line spoke1 = line(O, rim1) [construction]
num separation1 = free ~2.6900
num bearing1 = free ~68.0deg
point ic1 = rotate(offset(O, separation1, 0), O, bearing1) where { on(ic1, ray(O, rim1)) } { mark: none }
circle inner1 = circle(ic1, ir1) [auxiliary]
rel internally_tangent(outer, inner1)
point it1 = lerp(O, ic1, outer_radius / (outer_radius - ir1)) { mark: none }
line iu1 = tangent_line(E, inner1, 0) [construction]
line il1 = tangent_line(E, inner1, 1) [construction]
point ifu1 = foot(ic1, iu1) { mark: none }
point ifl1 = foot(ic1, il1) { mark: none }
assert coincident(it1, rim1)
assert on(it1, inner1) and on(it1, outer)
assert perpendicular(seg(ic1, ifu1), iu1) and perpendicular(seg(ic1, ifl1), il1)
assert dist(E, ifu1) == dist(E, ifl1)
assert coincident(reflect(ifu1, line(ic1, E)), ifl1)
