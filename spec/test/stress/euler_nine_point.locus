point e2_o = circumcenter(e1_ma, e1_mb, e1_mc) { mark: none }
point e2_g = centroid(e1_ma, e1_mb, e1_mc) { mark: none }
point e2_h = orthocenter(e1_ma, e1_mb, e1_mc) { mark: none }
circle e2_circ = circumcircle(e1_ma, e1_mb, e1_mc) [construction]
circle e2_inc = incircle(e1_ma, e1_mb, e1_mc) [auxiliary]
point e2_ma = midpoint(e1_mb, e1_mc) { mark: none }
point e2_mb = midpoint(e1_ma, e1_mc) { mark: none }
point e2_mc = midpoint(e1_ma, e1_mb) { mark: none }
circle e2_nine = circumcircle(e2_ma, e2_mb, e2_mc) [highlight]
point e2_fa = foot(e1_ma, line(e1_mb, e1_mc)) { mark: none }
point e2_fb = foot(e1_mb, line(e1_ma, e1_mc)) { mark: none }
point e2_fc = foot(e1_mc, line(e1_ma, e1_mb)) { mark: none }
assert collinear(e2_o, e2_g, e2_h)
assert radius(e2_nine) == radius(e2_circ) / 2
assert on(e2_fa, e2_nine) and on(e2_fb, e2_nine) and on(e2_fc, e2_nine)
assert tangent(e2_inc, e2_nine)
assert inside(center(e2_inc), e2_tri)
polygon e3_tri = polygon(e2_ma, e2_mb, e2_mc) [construction]
point e3_o = circumcenter(e2_ma, e2_mb, e2_mc) { mark: none }
point e3_g = centroid(e2_ma, e2_mb, e2_mc) { mark: none }
point e3_h = orthocenter(e2_ma, e2_mb, e2_mc) { mark: none }
circle e3_circ = circumcircle(e2_ma, e2_mb, e2_mc) [construction]
circle e3_inc = incircle(e2_ma, e2_mb, e2_mc) [auxiliary]
point e3_ma = midpoint(e2_mb, e2_mc) { mark: none }
point e3_mb = midpoint(e2_ma, e2_mc) { mark: none }
point e3_mc = midpoint(e2_ma, e2_mb) { mark: none }
circle e3_nine = circumcircle(e3_ma, e3_mb, e3_mc) [highlight]
point e3_fa = foot(e2_ma, line(e2_mb, e2_mc)) { mark: none }
point e3_fb = foot(e2_mb, line(e2_ma, e2_mc)) { mark: none }
point e3_fc = foot(e2_mc, line(e2_ma, e2_mb)) { mark: none }
