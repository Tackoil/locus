polygon e4_tri = polygon(e3_ma, e3_mb, e3_mc) [construction]
point e4_o = circumcenter(e3_ma, e3_mb, e3_mc) { mark: none }
point e4_g = centroid(e3_ma, e3_mb, e3_mc) { mark: none }
point e4_h = orthocenter(e3_ma, e3_mb, e3_mc) { mark: none }
circle e4_circ = circumcircle(e3_ma, e3_mb, e3_mc) [construction]
circle e4_inc = incircle(e3_ma, e3_mb, e3_mc) [auxiliary]
point e4_ma = midpoint(e3_mb, e3_mc) { mark: none }
point e4_mb = midpoint(e3_ma, e3_mc) { mark: none }
point e4_mc = midpoint(e3_ma, e3_mb) { mark: none }
circle e4_nine = circumcircle(e4_ma, e4_mb, e4_mc) [highlight]
point e4_fa = foot(e3_ma, line(e3_mb, e3_mc)) { mark: none }
point e4_fb = foot(e3_mb, line(e3_ma, e3_mc)) { mark: none }
