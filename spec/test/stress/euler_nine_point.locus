locus 2

meta {
  title "Euler line and the nine-point circle"
  note  "Almost entirely derived-tier: construct when you can, relate when you must"
}

style textbook

// ---- objects ----------------------------------------------
// Generic-position triangle: hint-settled by design.
point A = free ~(0, 3.5)
point B = free ~(-2, 0)
point C = free ~(4.5, 0)

polygon tri = polygon(A, B, C)

point O = circumcenter(A, B, C)
point G = centroid(A, B, C)
point H = orthocenter(A, B, C)

circle circ  = circumcircle(A, B, C)     [auxiliary]
line   euler = line(O, H)                [highlight]

// side midpoints
point M_a = midpoint(B, C)
point M_b = midpoint(A, C)
point M_c = midpoint(A, B)

// altitude feet
point H_a = foot(A, line(B, C))
point H_b = foot(B, line(A, C))
point H_c = foot(C, line(A, B))

// Euler points (midpoints of vertex-to-orthocenter)
point E_a = midpoint(A, H)
point E_b = midpoint(B, H)
point E_c = midpoint(C, H)

circle nine = circumcircle(M_a, M_b, M_c)   [highlight]
point  N    = center(nine)

// bonus: reflection of H over BC lies on the circumcircle
point H' = reflect(H, line(B, C))           [construction]

// ---- annotation ------------------------------------------
label lO = label(O, $O$)
label lG = label(G, $G$)
label lH = label(H, $H$)
label lN = label(N, $N$)  { dir: NE }
label lA = label(A, $A$)
label lB = label(B, $B$)
label lC = label(C, $C$)

// ---- intent ----------------------------------------------
assert collinear(O, G, H)
assert collinear(O, N, H)
assert ratio(dist(H, G), dist(G, O)) == 2
assert coincident(N, midpoint(O, H))           // was finding F4 — now a predicate
assert radius(nine) == radius(circ) / 2
assert concyclic(M_a, M_b, M_c, H_a, H_b, H_c, E_a, E_b, E_c)
assert on(H', circ)

// ---- stress construction network ----
// Five connected medial levels exercise shrinking scales and the Feuerbach contact.
polygon e0_tri = polygon(A, B, C) [construction]
point e0_o = circumcenter(A, B, C) { mark: none }
point e0_g = centroid(A, B, C) { mark: none }
point e0_h = orthocenter(A, B, C) { mark: none }
circle e0_circ = circumcircle(A, B, C) [construction]
circle e0_inc = incircle(A, B, C) [auxiliary]
point e0_ma = midpoint(B, C) { mark: none }
point e0_mb = midpoint(A, C) { mark: none }
point e0_mc = midpoint(A, B) { mark: none }
circle e0_nine = circumcircle(e0_ma, e0_mb, e0_mc) [highlight]
point e0_fa = foot(A, line(B, C)) { mark: none }
point e0_fb = foot(B, line(A, C)) { mark: none }
point e0_fc = foot(C, line(A, B)) { mark: none }
assert collinear(e0_o, e0_g, e0_h)
assert radius(e0_nine) == radius(e0_circ) / 2
assert on(e0_fa, e0_nine) and on(e0_fb, e0_nine) and on(e0_fc, e0_nine)
assert tangent(e0_inc, e0_nine)
assert inside(center(e0_inc), e0_tri)
polygon e1_tri = polygon(e0_ma, e0_mb, e0_mc) [construction]
point e1_o = circumcenter(e0_ma, e0_mb, e0_mc) { mark: none }
point e1_g = centroid(e0_ma, e0_mb, e0_mc) { mark: none }
point e1_h = orthocenter(e0_ma, e0_mb, e0_mc) { mark: none }
circle e1_circ = circumcircle(e0_ma, e0_mb, e0_mc) [construction]
circle e1_inc = incircle(e0_ma, e0_mb, e0_mc) [auxiliary]
point e1_ma = midpoint(e0_mb, e0_mc) { mark: none }
point e1_mb = midpoint(e0_ma, e0_mc) { mark: none }
point e1_mc = midpoint(e0_ma, e0_mb) { mark: none }
circle e1_nine = circumcircle(e1_ma, e1_mb, e1_mc) [highlight]
point e1_fa = foot(e0_ma, line(e0_mb, e0_mc)) { mark: none }
point e1_fb = foot(e0_mb, line(e0_ma, e0_mc)) { mark: none }
point e1_fc = foot(e0_mc, line(e0_ma, e0_mb)) { mark: none }
assert collinear(e1_o, e1_g, e1_h)
assert radius(e1_nine) == radius(e1_circ) / 2
assert on(e1_fa, e1_nine) and on(e1_fb, e1_nine) and on(e1_fc, e1_nine)
assert tangent(e1_inc, e1_nine)
assert inside(center(e1_inc), e1_tri)
