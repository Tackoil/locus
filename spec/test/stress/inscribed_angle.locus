locus 0 beta 6

meta title = "Inscribed angle theorem"

style textbook

// ---- objects ----------------------------------------------
circle c(3)
point O = c.center

point P = on_circle(c, 110deg)
point A = on_circle(c, 200deg)
point B = on_circle(c, 340deg)

segment pa(P, A)
segment pb(P, B)
segment oa(O, A)   [auxiliary]
segment ob(O, B)   [auxiliary]

arc sub(c, A, B, false)   [highlight]    // the subtended arc, CW side

arc inscribed = angle_arc(A, P, B, 0.55)
arc central   = angle_arc(A, O, B, 0.4)

// ---- annotation ------------------------------------------
label lP(P, $P$)
label lA(A, $A$)
label lB(B, $B$)
label lO(O, $O$)  { dir: N }

label li(P, $\theta$)             { dir: S,  gap: 0.8 }
label lc(O, $2\theta$)            { dir: S,  gap: 0.6 }

arrow see(li.center, lc.center)  [construction]  { head: ->, bend: -30deg }

text_block thm($\angle AOB = 2\,\angle APB$)  { place: below }

// ---- intent ----------------------------------------------
assert on(P, c) and on(A, c) and on(B, c)
assert angle(A, O, B) == 2 * angle(A, P, B)   tol 1e-9

// ---- stress construction network ----
// A chord fan shares endpoints; opposite arcs test supplementary angles.
point fan0 = on_circle(c, 5deg) { mark: none }
segment fa0(A, fan0) [construction]
segment fb0(B, fan0) [construction]
point fm0 = midpoint(A, fan0) { mark: none }
segment fr0(O, fm0) [auxiliary]
arc fan_angle0 = angle_arc(A, fan0, B, 0.16)
assert angle(A, fan0, B) == 70deg
assert perpendicular(fr0, fa0)
assert dist(O, fm0) * dist(O, fm0) + dist(A, fm0) * dist(A, fm0) == radius(c) * radius(c)
point fan1 = on_circle(c, 25deg) { mark: none }
segment fa1(A, fan1) [construction]
segment fb1(B, fan1) [construction]
point fm1 = midpoint(A, fan1) { mark: none }
segment fr1(O, fm1) [auxiliary]
arc fan_angle1 = angle_arc(A, fan1, B, 0.16)
assert angle(A, fan1, B) == 70deg
assert perpendicular(fr1, fa1)
assert dist(O, fm1) * dist(O, fm1) + dist(A, fm1) * dist(A, fm1) == radius(c) * radius(c)
