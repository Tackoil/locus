locus 0 beta 6

meta title = "Angle bisector theorem: BD/DC = AB/AC"

style textbook

// ---- objects ----------------------------------------------
// A scalene triangle inscribed in a circle; Locus owns the circle's placement.
circle circum(3.5)   [construction]
point A = circum.at(80deg)
point B = circum.at(210deg)
point C = circum.at(330deg)

polygon tri(A, B, C)

line bis = angle_bisector(B, A, C)   [construction]

// The bisector meets the opposite side at a unique derived point.
point D = intersect(bis, seg(B, C))

segment ad(A, D)               [auxiliary]

// equal-angle marks at vertex A (n: multiplicity — finding F2 resolved)
arc m1 = angle_arc(B, A, D, 0.5)  { n: 1 }
arc m2 = angle_arc(D, A, C, 0.5)  { n: 1 }

// ---- annotation ------------------------------------------
label lA(A, $A$)
label lB(B, $B$)
label lC(C, $C$)
label lD(D, $D$)  { dir: S }

label lbd(seg(B, D).midpoint, $m$)  { dir: S, gap: 0.35 }
label ldc(seg(D, C).midpoint, $n$)  { dir: S, gap: 0.35 }

text_block eq($\dfrac{m}{n} = \dfrac{AB}{AC}$)  { place: below }

// ---- intent ----------------------------------------------
assert on(D, bis) and on(D, seg(B, C))
assert between(B, D, C)
assert angle(B, A, D) == angle(D, A, C)
assert ratio(dist(B, D), dist(D, C)) == ratio(dist(A, B), dist(A, C))
