locus 0 beta 6

meta title = "AEC3 adaptive FIR filters aligned along time"
meta note = "Each filter reads a different, overlapping region of the same render history. Scale: 1 unit = 32 ms."

style textbook

class filterbox { accent: #2563EB, fill: #DBEAFE, weight: 1.25, join: round }
class overlap   { accent: #0F766E, fill: #CCFBF1, weight: 0.75, opacity: 0.88 }
class coeff     { accent: #2563EB, weight: 1 }
class offsetln  { stroke: dash(6, 3), accent: #2563EB, weight: 1, cap: round }
class peak      { accent: #EA580C, weight: 2, cap: round }
class peakln    { stroke: dash(6, 3), accent: #EA580C, weight: 1.25, cap: round }

// Only physical sizes are fixed; layout gaps are chosen by the engine.
num fw = 4       // 128 ms
num ov = 1       // 32 ms
num bh = 1.2

rect f0(fw, bh) [filterbox]
rect f1(fw, bh) [filterbox]
rect f2(fw, bh) [filterbox]
rect f3(fw, bh) [filterbox]
rect f4(fw, bh) [filterbox]
rel gap_y(f0, f1, f2, f3, f4)
// Temporal overlap determines horizontal alignment, not layout coordinates.
rel hdist(f1.w, f0.e) == ov
rel hdist(f2.w, f1.e) == ov
rel hdist(f3.w, f2.e) == ov
rel hdist(f4.w, f3.e) == ov

fn filter_caption(box, name, span) {
    label heading(name)
    label range(span)
    rel column(heading, range)
    group captions(heading, range)
    rel center(captions, box)
}
filter_caption cpt0(f0, "Filter 0", "0–128 ms")
filter_caption cpt1(f1, "Filter 1", "96–224 ms")
filter_caption cpt2(f2, "Filter 2", "192–320 ms")
filter_caption cpt3(f3, "Filter 3", "288–416 ms")
filter_caption cpt4(f4, "Filter 4", "384–512 ms")

fn overlap_strip(box) {
    rect shape(ov, bh) [overlap]
    rel align_center_y(shape, box)
}
overlap_strip s0e(f0)
rel inset_right(s0e.shape, f0) { padding: none }
overlap_strip s1w(f1)
rel inset_left(s1w.shape, f1) { padding: none }
overlap_strip s1e(f1)
rel inset_right(s1e.shape, f1) { padding: none }
overlap_strip s2w(f2)
rel inset_left(s2w.shape, f2) { padding: none }
overlap_strip s2e(f2)
rel inset_right(s2e.shape, f2) { padding: none }
overlap_strip s3w(f3)
rel inset_left(s3w.shape, f3) { padding: none }
overlap_strip s3e(f3)
rel inset_right(s3e.shape, f3) { padding: none }
overlap_strip s4w(f4)
rel inset_left(s4w.shape, f4) { padding: none }

// Axis ticks inherit the temporal boundaries of the fixed-size filters.
point A0() { mark: cross }
point A512() { mark: cross }
rel align_center_x(A0, f0.w)
rel align_center_x(A512, f4.e)
rel align_center_y(A0, A512)
arrow axis(A0, A512) { head: -> }
rel gap_y(f4, axis)
label lax(A0, "render history x[t]") { dir: W }

fn time_tick(boundary, text) {
    point position() { mark: cross }
    rel align_center_x(position, boundary)
    rel on(position, seg(A0, A512))
    label caption(position, text) { dir: S }
}
time_tick t96(f1.w, "96")
time_tick t128(f0.e, "128")
time_tick t192(f2.w, "192")
time_tick t224(f1.e, "224")
time_tick t288(f3.w, "288")
time_tick t320(f2.e, "320")
time_tick t384(f4.w, "384")
time_tick t416(f3.e, "416")
label lt0(A0, "0 ms") { dir: S }
label lt512(A512, "512 ms") { dir: S }

// Capture feed and taps are aligned by relations rather than offsets.
point cap_top() { mark: none }
point cap_bot() { mark: none }
rel align_center_y(cap_top, f0.center)
rel align_center_y(cap_bot, f4.center)
rel align_center_x(cap_top, cap_bot)
segment cap(cap_top, cap_bot)
rel gap_x(cap, f0)
label lcap(cap_top, "capture y[t]") { dir: NW }

fn capture_tap(box) {
    point tail() { mark: none }
    rel on(tail, cap)
    rel align_center_y(tail, box.center)
    arrow path(tail, box.w) { head: -> }
}
capture_tap c0(f0)
capture_tap c1(f1)
capture_tap c2(f2)
capture_tap c3(f3)
capture_tap c4(f4)

// Coefficient stems share a baseline; the engine chooses their spacing.
fn coefficient(height) {
    point base() { mark: none }
    point tip() [coeff] { mark: dot }
    rel on(base, seg(f2.sw, f2.se))
    rel align_center_x(base, tip)
    rel vdist(base, tip) == height
    rel contain(f2, tip)
    segment stem(base, tip) [coeff]
}
coefficient st1(0.22)
coefficient st2(0.30)
coefficient st3(0.24)
coefficient st4(0.28)
coefficient st5(0.20)
coefficient st6(0.26)

// The peak remains at the temporal midpoint of filter 2.
point kb() { mark: none }
rel midpoint(kb, f2.sw, f2.se)
point kstar() [peak] { mark: dot }
rel align_center_x(kstar, kb)
rel contain(f2, kstar)
rel vdist(kb, kstar) == 0.45
segment stk(kb, kstar) [peak]
label lk(kstar, "local peak k*") [peak] { dir: E }

segment o2drop(f2.sw, t192.position) [offsetln]
label lo2(o2drop.midpoint, "filter offset $O_2$") [offsetln] { dir: W }
point kdrop() { mark: none }
rel on(kdrop, seg(A0, A512))
rel align_center_x(kdrop, kb)
segment kline(kb, kdrop) [peakln]

rect td()
label ltd("total delay = filter offset $O_2$ + local peak $k^*$")
rel center(ltd, td)
rel contain(td, ltd)
rel align_center_x(td, kdrop)
rel gap_y(axis, td)

rect lg(0.6, 0.45) [overlap]
label llg("32 ms overlap")
rel row(lg, llg)
group legend(lg, llg)
rel gap_x(f0, legend)
rel align_center_y(legend, f0)

label lg1("coefficient position → delay") [coeff]
label lg2("coefficient height → echo gain") [coeff]
rel row(lg1, lg2)
group coefficient_legend(lg1, lg2)
rel gap_y(td, coefficient_legend)
rel align_center_x(td, coefficient_legend)

text_block sub("Each filter reads a different, overlapping region of the same render history") { place: above }
text_block eq($\hat{y}[t] = \textstyle\sum_n h_n[k]\, x[t - (O_n + k)]$) { place: below }

// Physical invariants remain independent of automatic layout spacing.
assert f0.width == fw and f0.height == bh
assert f1.width == fw and f1.height == bh
assert f2.width == fw and f2.height == bh
assert f3.width == fw and f3.height == bh
assert f4.width == fw and f4.height == bh
assert hdist(f1.w, f0.e) == ov and hdist(f2.w, f1.e) == ov
assert hdist(f3.w, f2.e) == ov and hdist(f4.w, f3.e) == ov
assert align_center_x(f0.w, A0) and align_center_x(f2.w, t192.position)
assert hdist(A0, A512) == 16
assert on(kdrop, seg(A0, A512))
assert between(t224.position, kdrop, t288.position)
assert hdist(A0, kdrop) == hdist(A0, t192.position) + hdist(t192.position, kdrop)
