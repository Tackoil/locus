locus 0 beta 6

meta title = "Euler line and the nine-point circle"
meta note = "Almost entirely derived-tier: construct when you can, relate when you must"

style textbook

// ---- objects ----------------------------------------------
// A scalene triangle on its circumcircle; all points are derived.
circle circ(3.5)   [auxiliary]
point A = circ.at(90deg)
point B = circ.at(210deg)
point C = circ.at(340deg)

polygon tri(A, B, C)

point O = circ.center
point G = centroid(A, B, C)
point H = orthocenter(A, B, C)

line euler(O, H)                [highlight]

// side midpoints
point M_a = midpoint(B, C)
point M_b = midpoint(A, C)
point M_c = midpoint(A, B)

// altitude feet
point H_a = foot(A, line(B, C))
point H_b = foot(B, line(A, C))
point H_c = foot(C, line(A, B))

// Euler points (midpoints of vertex-to-orthocenter)
point E_a = midpoint(A, H)
point E_b = midpoint(B, H)
point E_c = midpoint(C, H)

circle nine = circumcircle(M_a, M_b, M_c)   [highlight]
point  N    = center(nine)

// bonus: reflection of H over BC lies on the circumcircle
point H' = reflect(H, line(B, C))           [construction]

// ---- annotation ------------------------------------------
label lO(O, $O$)
label lG(G, $G$)
label lH(H, $H$)
label lN(N, $N$)  { dir: NE }
label lA(A, $A$)
label lB(B, $B$)
label lC(C, $C$)

// ---- intent ----------------------------------------------
assert center(O, circumcenter(A, B, C))
assert collinear(O, G, H)
assert collinear(O, N, H)
assert ratio(dist(H, G), dist(G, O)) == 2
assert center(N, midpoint(O, H))           // was finding F4 — now a predicate
assert radius(nine) == radius(circ) / 2
assert concyclic(M_a, M_b, M_c, H_a, H_b, H_c, E_a, E_b, E_c)
assert on(H', circ)
