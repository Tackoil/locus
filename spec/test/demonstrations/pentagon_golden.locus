locus 0 beta 5

meta title = "Golden ratio in the regular pentagon"
meta note = "Vertices by rotation around a placed circle; diagonal intersection is derived"

style textbook

// ---- objects ----------------------------------------------
circle circ = circle(3)   [construction]
point O = circ.center
point A = circ.at(90deg)

point B = rotate(A, O, 72deg)
point C = rotate(A, O, 144deg)
point D = rotate(A, O, 216deg)
point E = rotate(A, O, 288deg)

polygon pent = polygon(A, B, C, D, E)

segment d1 = seg(A, C)   [highlight]
segment d2 = seg(B, E)   [highlight]

// The diagonals have a unique intersection, so no branch selector is needed.
point P = intersect(d1, d2)

// equal-side ticks
tick t1 = tick(seg(A, B), 1)
tick t2 = tick(seg(B, C), 1)

// ---- annotation ------------------------------------------
label lA = label(A, $A$)
label lB = label(B, $B$)
label lC = label(C, $C$)
label lD = label(D, $D$)
label lE = label(E, $E$)
label lP = label(P, $P$)  { dir: N }

text_block phi = text_block($\dfrac{AC}{AB} = \varphi = \dfrac{1+\sqrt5}{2}$)  { place: below }

// ---- intent ----------------------------------------------
assert on(P, d1) and on(P, d2)
assert dist(A, B) == dist(B, C)
assert ratio(dist(A, C), dist(A, B)) == (1 + sqrt(5)) / 2
assert ratio(dist(P, C), dist(A, P)) == (1 + sqrt(5)) / 2 // longer / shorter diagonal part
assert inside(P, pent)
