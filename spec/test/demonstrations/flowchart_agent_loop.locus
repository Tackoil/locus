locus 0 beta 5

meta title = "Agent workflow: never render until check passes"
meta note = "Nodes own their placement; anchor relations define the spine and fix branch"

style textbook

// ---- sizing constants --------------------------------------
num bw    = 3.4        // box width
num bh    = 1.1        // box height
num pitch = 2.3        // vertical center-to-center pitch
num side  = 5.6        // offset to the fix branch

// ---- spine nodes --------------------------------------------
rect n1 = rect(bw, bh)
label t1 = label(n1.center, "locus init")  { dir: center }

rect n2 = rect(bw, bh) where { vertical(n1.center, n2.center), vdist(n2.center, n1.center) == pitch }
label t2 = label(n2.center, "locus add < ops.locus")  { dir: center }

rect n3 = rect(bw, bh) where { vertical(n2.center, n3.center), vdist(n3.center, n2.center) == pitch }
label t3 = label(n3.center, "locus check")  { dir: center }

diamond n4 = diamond(3.2, 1.5) where { vertical(n3.center, n4.center), vdist(n4.center, n3.center) == pitch }
label   t4 = label(n4.center, "exit 0?")  { dir: center }

rect n5 = rect(bw, bh) where { vertical(n4.center, n5.center), vdist(n5.center, n4.center) == pitch }   [highlight]
label t5 = label(n5.center, "locus render -o fig.svg")  { dir: center }

// ---- side node: fix ------------------------------------------
rect nf = rect(bw, bh) where { horizontal(n4.center, nf.center), hdist(n4.center, nf.center) == side }
label tf = label(nf.center, "fix ops (update / edit)")  { dir: center }

// ---- edges ----------------------------------------------------
arrow a1 = arrow(n1.s, n2.n)  { head: -> }
arrow a2 = arrow(n2.s, n3.n)  { head: -> }
arrow a3 = arrow(n3.s, n4.n)  { head: -> }
arrow a4 = arrow(n4.s, n5.n)  { head: -> }
label ly = label(n4.s, "yes")  { dir: SW, gap: 0.15 }
arrow a5 = arrow(n4.e, nf.w)  { head: -> }
label ln = label(n4.e, "no")   { dir: NE, gap: 0.15 }
arrow a6 = arrow(nf.n, n2.e)  { head: ->, bend: 40deg }

// ---- layout invariants — the Locus payoff ---------------------
assert collinear(n1.center, n2.center, n3.center, n4.center, n5.center) // spine
assert vdist(n2.center, n1.center) == vdist(n3.center, n2.center)       // equal pitch
assert n1.width == n3.width                        // equal widths
assert horizontal(n4.center, nf.center)            // fix branch on the decision row
