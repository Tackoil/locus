locus 0 beta 6

meta title = "Cubic B-spline from a frame's derived anchors"
meta note = "Five controls produce two spans; only the endpoint controls are interpolated by definition"

style textbook

// ---- frame, controls, and curve ----------------------------
rect frame(8, 4)   [construction]
point P0 = frame.sw
point P1 = frame.nw
point P2 = frame.n
point P3 = frame.se
point P4 = frame.e

bspline curve(P0, P1, P2, P3, P4)   [highlight]
segment control01(P0, P1)   [auxiliary]
segment control12(P1, P2)   [auxiliary]
segment control23(P2, P3)   [auxiliary]
segment control34(P3, P4)   [auxiliary]

// This sample is at the interior knot, not halfway along the arc length.
point M = curve.at(0.5)
point Q = curve.at(0.25)

// ---- annotation -------------------------------------------
label lP0(P0, $P_0$)   { dir: SW }
label lP1(P1, $P_1$)   { dir: NW }
label lP2(P2, $P_2$)   { dir: N }
label lP3(P3, $P_3$)   { dir: SE }
label lP4(P4, $P_4$)   { dir: E }
label lM(M, "$t = 0.5$")   { dir: N }
label lQ(Q, "$t = 0.25$")   { dir: E }

// ---- intent -----------------------------------------------
assert center(curve.start, P0) and center(curve.end, P4)
assert center(curve.at(0), P0) and center(curve.at(1), P4)
assert center(M, midpoint(midpoint(P1, P2), midpoint(P2, P3)))
assert dist(Q, P1) > 0
assert hdist(P0, P4) == frame.width
